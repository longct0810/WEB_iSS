HTTP_PORT=6580

# Login JWT used by the Web App to request HES WebSocket tickets.
LOGIN_JWT_SECRET=replace-with-at-least-32-random-characters
LOGIN_JWT_ISSUER=smartgrid-web
LOGIN_JWT_AUDIENCE=smartgrid-web-app
LOGIN_JWT_TTL=8h

# HES WebSocket ticket signing. Keep the private key outside the repository.
HES_WS_PRIVATE_KEY_PATH=./config/keys/webapp-ws-private.pem
HES_WS_JWT_KEY_ID=smartgrid-ws-2026-01
HES_WS_JWT_ISSUER=smartgrid-web
HES_WS_JWT_AUDIENCE=hes104-ws
HES_WS_TICKET_TTL_SEC=90
HES_WS_URL=wss://smartgrid.ifc.com.vn:6332/ws
# Development only; production must use the database ACL.
HES_WS_LOCAL_ALLOWED_DEVICES=366621,366481

POWERAI_API_URL=http://127.0.0.1:8080
POWERAI_TIMEOUT_MS=10000
# Phải giống SERVICE_API_KEY của PowerAI. Để trống chỉ dùng cho development.
POWERAI_API_KEY=
# Chỉ giữ ở SMARTGRID backend, tuyệt đối không đưa khóa này ra trình duyệt.
POWERAI_ADMIN_KEY=
# Khi hai dịch vụ cùng máy, có thể đọc khóa trực tiếp từ env của PowerAI.
# Biến POWERAI_API_KEY/POWERAI_ADMIN_KEY ở trên luôn được ưu tiên nếu đã đặt.
POWERAI_ENV_FILE=

# Qwen chạy qua Ollama API. URL không kèm /api/chat.
QWEN_API_URL=http://127.0.0.1:11434
QWEN_API_KEY=
QWEN_MODEL=qwen3:4b
QWEN_TIMEOUT_MS=120000
QWEN_NUM_CTX=8192
QWEN_NUM_PREDICT=700
QWEN_TEMPERATURE=0.1
QWEN_KEEP_ALIVE=10m
SMARTGRID_SOCKET_URL=wss://smartgrid.ifc.com.vn:6332
CORS_ORIGINS=http://localhost:6580,http://14.177.66.131:6580
# Chỉ bật khi i0 đến từ cảm biến dòng dư trực tiếp, không phải giá trị suy diễn.
POWER_AI_DIRECT_I0_ENABLED=false
