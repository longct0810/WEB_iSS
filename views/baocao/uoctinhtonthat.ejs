                            <div class="content-body">
                                <!-- row -->
                                <div class="container-fluid">

                                    <div class="row">
                                        <div class="col-lg-12 card">
                                            <div class="profile card-body px-3 pt-3 pb-0">
                                                <div class="row">
                                                    <div class="col-lg-6 ngay col-xl-6" style="padding: 10px; ">
                                                        <div class="row">
                                                            <div class="col-lg-6 ngay col-xl-6" style="padding: 10px; ">
                                                                <div class="input-group input-primary">
                                                                    <span class="input-group-text">Từ ngày</span>
                                                                    <input name="datepicker"
                                                                        class="datepicker-default form-control"
                                                                        id="txttungay_uttt">

                                                                </div>
                                                            </div>

                                                        </div>
                                                        <div class="row">
                                                            <div class="col-lg-6 ngay col-xl-6" style="padding: 10px; ">
                                                                <div class="input-group input-primary">
                                                                    <span class="input-group-text">Đến ngày</span>
                                                                    <input name="datepicker"
                                                                        class="datepicker-default form-control"
                                                                        id="txtdenngay_uttt">

                                                                </div>
                                                            </div>

                                                            <div class="col-lg-4 col-xl-4" style="padding: 10px; ">
                                                                <div class="input-group">
                                                                    <button class="btn btn-primary" type="button"
                                                                        id="btnthuchien_uttt"><i
                                                                            class="flaticon-013-checkmark"></i>
                                                                        Xem</button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="col-lg-6 col-xl-6" style="padding: 10px; ">
                                                        <div class="input-group">
                                                            <table style="margin-top: 15px;font-size: 18px;">
                                                                <tr>
                                                                    <td style="text-align:center">
                                                                        ĐẦU NGUỒN - ĐIỆN
                                                                        THƯƠNG PHẨM</td>
                                                                    <td rowspan="2" style="padding-bottom: 4px;">
                                                                        &nbsp; x 100 = <span
                                                                            style="color: darkorange; font-weight:bold"
                                                                            id="ketquauoctinh"> </span>% </td>
                                                                </tr>
                                                                <tr style="border-top: 1px solid #000">
                                                                    <td style="text-align:center">ĐẦU NGUỒN</td>
                                                                    <td style="text-align:center"></td>
                                                                </tr>

                                                            </table>
                                                        </div>
                                                    </div>

                                                </div>
                                                <div class="row">
                                                    <div class="form-group col-lg-6">
                                                        <input type="radio" class="form-check-input" value="1"
                                                            id="rddiemdodaunguon" name="typeUT"
                                                            onchange="loaiUocTinhChange(this)" checked>Nhập điểm đo đầu
                                                        nguồn
                                                        <input type="radio" class="form-check-input" value="2"
                                                            id="rdchisodaunguon" name="typeUT"
                                                            onchange="loaiUocTinhChange(this)">Nhập chỉ số đầu nguồn

                                                    </div>
                                                </div>
                                                <div class="row nhapchiso">
                                                    <div class="col-lg-2">
                                                        <label style="margin-top: 6px;">Nhập mã điểm đo: </label>
                                                    </div>
                                                    <div class="form-group col-lg-3">
                                                        <input id="ls_madiemdo_cu" class="form-control" trim
                                                            maxlength="50">
                                                    </div>
                                                </div>

                                                <div class="row nhapdiemdo" style="display: none;">
                                                    <div class="col-lg-12">
                                                        <div class="mb-3">

                                                            <div class="input-group input-primary">
                                                                <span class="input-group-text"> ( Chỉ số mới: </span>
                                                                <input type="number" class="form-control"
                                                                    id="txt_nhap_csmoi" min="1" style="width: 90px;"
                                                                    class="form-control"
                                                                    oninput="validatePositiveNumber(this)"
                                                                    onchange="onNhapTay()">
                                                                <span class="input-group-text"> KWh - Chỉ số cũ: </span>
                                                                <input type="number" class="form-control"
                                                                    id="txt_nhap_cscu" min="1"
                                                                    oninput="validatePositiveNumber(this)"
                                                                    onchange="onNhapTay()">
                                                                <span class="input-group-text"> KWh ) * HSN:
                                                                </span>
                                                                <input type="number" class="form-control"
                                                                    id="txt_nhap_hsn" min="1" style="width: 90px;"
                                                                    class="form-control"
                                                                    oninput="validatePositiveNumber(this)"
                                                                    onchange="onNhapTay()">
                                                                <span class="input-group-text">=</span>
                                                                <input type="number" class="form-control"
                                                                    id="txt_nhap_sl" min="1" style="width: 90px;"
                                                                    class="form-control">
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group col-lg-12"
                                                        style="height:300px; display: none;" id="modal_bieudo_uoctinh">
                                                        <canvas id="bieudo_uoctinh" style="height:300px">{{ chart
                                                            }}</canvas>
                                                    </div>
                                                    <div style="text-align:center">
                                                        <span
                                                            style="width:20px; height:10px; background-color: #14CDE9;display: inline-block;margin-right: 10px;"></span>
                                                        <span>CS ngày cuối - CS ngày đầu</span>
                                                    </div>
                                                </div>
                                                <div class="row" style="margin-top: 40px;">
                                                    <div class="form-group col-lg-12">
                                                        <table class="table table-bordered  table-sm"
                                                            id="tbl_uoctinhtonthat">
                                                            <thead>
                                                                <tr>
                                                                    <th class="text-center">Trạm</th>
                                                                    <th class="text-center">Chỉ số mới</th>
                                                                    <th class="text-center">Chỉ số cũ</th>
                                                                    <th class="text-center">Sản lượng</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <tr>
                                                                    <td class="text-left">Đầu nguồn</td>
                                                                    <td class="text-right"></td>
                                                                    <td class="text-right"></td>
                                                                    <td class="text-right"></td>
                                                                </tr>
                                                                <tr>
                                                                    <td class="text-left">Điện thương phẩm</td>
                                                                    <td class="text-right"></td>
                                                                    <td class="text-right"></td>
                                                                    <td class="text-right"></td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                                <div class="row">

                                                    <div class="col-lg-12">
                                                        <table class="table table-bordered table-striped table-sm"
                                                            id="tbl_diemdo">
                                                            <thead>
                                                                <tr>
                                                                    <th class="text-center">STT</th>
                                                                    <th class="text-center">Mã điểm đo</th>
                                                                    <th class="text-center">Số công tơ</th>
                                                                    <th class="text-center">Khách hàng</th>
                                                                    <th class="text-center">Chỉ số mới</th>
                                                                    <th class="text-center">Chỉ số cũ</th>
                                                                    <th class="text-center">Hệ số nhân</th>
                                                                    <th class="text-center">Sản lượng</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>

                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                    </div>

                                </div>
                            </div>
        </div>

        <!--**********************************
        Content body end
