        <link rel="stylesheet" href="./stylesheets/jstree.min.css">
        <link rel="stylesheet" href="./vendor/toastr/css/toastr.min.css">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
        <style>
          .form-row {
            margin-bottom: 14px;
          }

          .param-label {
            font-size: 12px;
            color: #666;
            margin-bottom: 2px;
          }

          .unit-box {
            display: flex;
            gap: 8px;
          }

          input,
          select {
            padding: 6px 8px;
            box-sizing: border-box;
          }

          input[type="number"] {
            width: 180px;
          }

          select.unit {
            width: 90px;
          }

          .box {
            border: 1px solid #ccc;
            background: #f9f9f9;
            padding: 12px;
            margin-top: 12px;
          }

          .invalid {
            border: 1px solid red !important;
            background-color: #ffe8e8 !important;
          }

          .password-input-wrap {
            position: relative;
          }

          .password-input-wrap .form-control {
            padding-right: 42px;
          }

          .toggle-password-btn {
            position: absolute;
            top: 50%;
            right: 10px;
            transform: translateY(-50%);
            border: none;
            background: transparent;
            padding: 0;
            margin: 0;
            color: #6c757d;
            cursor: pointer;
            z-index: 3;
            outline: none;
          }

          .toggle-password-btn:hover {
            color: #007bff;
          }

          .toggle-password-btn:focus {
            outline: none;
            box-shadow: none;
          }

          .season-box {
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 12px;
            background: #fff;
          }

          .season-toolbar {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            align-items: center;
            margin-bottom: 12px;
          }

          .season-toolbar .form-control {
            width: auto;
            min-width: 90px;
          }

          .season-list {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
          }

          .season-card {
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 10px;
            min-height: 100px;
          }

          .season-card h4 {
            font-size: 15px;
            margin: 0 0 8px;
          }

          .season-tag {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 8px;
            margin: 3px;
            background: #e8f3ff;
            border-radius: 12px;
          }

          .season-tag button {
            border: none;
            background: transparent;
            color: red;
            font-weight: bold;
            cursor: pointer;
          }

          .evn-table th {
            background: #f5f5f5;
            text-align: center;
            font-weight: 600;
          }

          .evn-table td {
            vertical-align: middle;
          }

          .tariff-section {
            border-bottom: 1px dashed #ccc;
            padding: 12px 0;
          }

          .tariff-time-row {
            display: flex;
            gap: 8px;
            margin-bottom: 6px;
          }

          .tariff-time-row select {
            min-width: 80px;
          }

          input[value="2"]:checked {
            accent-color: red;
          }

          .tariff-time-row {
            display: grid;
            grid-template-columns: 40px 80px 45px 80px 70px 160px 70px;
            gap: 8px;
            align-items: center;
            margin-bottom: 8px;
            padding: 8px;
            border: 1px solid #ddd;
            background: #fafafa;
          }

          .tariff-time-row label {
            margin: 0;
            font-weight: 600;
          }

          .tariff-time-row .form-control {
            height: 34px;
          }

          #daySelect option:disabled {
            color: #b5b5b5;
            background-color: #f3f3f3;
          }

          .select2-results__option[aria-disabled="true"] {
            color: #b5b5b5 !important;
            background-color: #f3f3f3 !important;
          }

          /* =========================
   CÀI ĐẶT THỜI GIAN CÔNG TƠ
========================= */

          .meter-time-box {
            background: #fff;
            border: 1px solid #dfe6ee;
            border-radius: 10px;
            padding: 16px;
            margin-top: 12px;
          }

          .meter-time-box h4 {
            margin-bottom: 16px;
            font-size: 16px;
            font-weight: 600;
            color: #1f2937;
          }

          .meter-time-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 14px;
          }

          .meter-time-grid label {
            display: block;
            margin-bottom: 6px;
            font-size: 13px;
            font-weight: 600;
            color: #374151;
          }

          .meter-time-grid select {
            width: 100%;
            height: 38px;
            border: 1px solid #cfd8e3;
            border-radius: 8px;
            padding: 0 10px;
            font-size: 14px;
            background: #fff;
            transition: all 0.2s ease;
          }

          .meter-time-grid select:focus {
            border-color: #3b82f6;
            outline: none;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
          }

          .meter-time-grid select:hover {
            border-color: #93c5fd;
          }

          .meter-time-mode {
            display: flex;
            gap: 20px;
            margin-bottom: 16px;
          }

          .meter-time-mode label {
            display: flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            font-weight: 600;
          }

          .meter-time-mode input[type="radio"] {
            width: 16px;
            height: 16px;
          }

          /* responsive */
          @media (max-width: 768px) {
            .meter-time-grid {
              grid-template-columns: repeat(2, 1fr);
            }
          }

          @media (max-width: 480px) {
            .meter-time-grid {
              grid-template-columns: 1fr;
            }
          }

          /* ===== SELECT DROPDOWN ICON ===== */

          .special-day-tariff-type,
          #specialDayTariffSelect,
          .tariff-type,
          .tariff-hour,
          .tariff-minute {
            appearance: none;
            -webkit-appearance: none;
            -moz-appearance: none;

            background-color: #fff;

            background-image: url("data:image/svg+xml;utf8,<svg fill='%23666' height='20' viewBox='0 0 20 20' width='20' xmlns='http://www.w3.org/2000/svg'><path d='M5.5 7.5l4.5 4.5 4.5-4.5'/></svg>");

            background-repeat: no-repeat;
            background-position: right 10px center;
            background-size: 16px;

            padding-right: 35px !important;
            cursor: pointer;
          }

          /* hover */
          .special-day-tariff-type:hover,
          #specialDayTariffSelect:hover,
          .tariff-type:hover {
            border-color: #409eff;
          }

          /* focus */
          .special-day-tariff-type:focus,
          #specialDayTariffSelect:focus,
          .tariff-type:focus {
            outline: none;
            border-color: #409eff;
            box-shadow: 0 0 0 2px rgba(64, 158, 255, 0.2);
          }

          .select-wrapper {
            position: relative;
          }

          .select-wrapper {
            position: relative;
            width: 100%;
          }

          .select-wrapper select {
            width: 100%;
            appearance: none;
            -webkit-appearance: none;
            -moz-appearance: none;
            padding-right: 38px !important;
          }

          .select-icon {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            pointer-events: none;
            color: #666;
            font-size: 14px;
            z-index: 10;
          }
        </style>