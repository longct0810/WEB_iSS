              <div class="content-body">
                <!-- row -->
                <div class="container-fluid">

                  <section class="content col-xl-12">

                    <!-- Default box -->
                    <div class="card card-info">

                      <div class="card-body p-0" style="margin: 20px;">
                        <div class="row" id="titlecongto">

                        </div>
                        <div class="row">
                          <div class="form-group col-lg-4" style="margin-bottom: 15px;">
                            <label>
                              Loại sự kiện
                              <span class="text-danger">(*)</span>
                            </label>
                            <div class="select-wrapper">
                              <select id="eventSelect" class="form-control">
                                <!-- Sẽ được fill bằng JS -->
                              </select>

                              <i class="fa fa-chevron-down select-icon"></i>
                            </div>
                          </div>

                          <div class="form-group col-lg-8" style="margin-bottom: 15px;">
                            <!-- Khu vực các tham số của sự kiện -->
                            <div id="eventParams" class="box">
                              <!-- JS render ra 4 dòng tương ứng -->
                            </div>
                            <div id="msg" class="box" style="display: none;">
                              <!-- JS render ra 4 dòng tương ứng -->
                            </div>
                          </div>

                        </div>
                        <div class="row">
                          <div class="form-group col-lg-12" style="margin-bottom: 15px;text-align: right;">
                            <button type="button" class="btn btn-primary" onclick="ThuHien_Doc()">Đọc thông số</button>
                            <button type="button" class="btn btn-primary" onclick="ThucHien_Ghi()">Lưu cấu
                              hình</button>
                            <pre id="resultJson"></pre>
                          </div>
                          <div class="modal fade" id="modalMeterPassword" tabindex="-1" role="dialog"
                            aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered" role="document">
                              <div class="modal-content">
                                <div class="modal-header">
                                  <h5 class="modal-title">Nhập mật khẩu công tơ</h5>

                                </div>

                                <div class="modal-body">
                                  <div class="form-group mb-0">
                                    <label for="meterPasswordInput">Mật khẩu</label>
                                    <div class="password-input-wrap">
                                      <input type="password" id="meterPasswordInput" class="form-control pr-5"
                                        placeholder="Nhập mật khẩu công tơ" autocomplete="off" />

                                      <button type="button" class="toggle-password-btn" id="toggleMeterPassword"
                                        aria-label="Hiển thị mật khẩu">
                                        <i class="fa fa-eye"></i>
                                      </button>
                                    </div>
                                    <small class="text-muted">Mật khẩu sẽ được dùng để ghi cấu hình công tơ.</small>
                                  </div>
                                </div>

                                <div class="modal-footer">
                                  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                  <button type="button" class="btn btn-primary" id="btnConfirmMeterPassword">Xác
                                    nhận</button>
                                  <input type="hidden" id="seasonActiveTime" />
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                      <!-- /.card-body -->
                    </div>

                    <!-- /.card -->

                  </section>

                </div>
              </div>
    </div>
    <!--**********************************
        Content body end
