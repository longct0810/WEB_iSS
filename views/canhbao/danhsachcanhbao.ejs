                                <option value="-1">Lựa chọn</option>
                              </select>
                            </div>
                          </div>
                          <div class="col-lg-3" style="padding: 10px; ">
                            <div class="input-group">
                              <button class="btn btn-primary" type="button" id="btnthuchien_dscb"><i
                                  class="flaticon-013-checkmark"></i>
                                Thực hiện</button>
                            </div>
                          </div>

                        </div>
                        <div class="row">
                          <table id="tbl_canhbao" class="table table-bordered table-striped danhsachcanhbao"
                            style="width:100%">
                            <thead>
                              <tr>
                                <th>STT</th>
                                <th>Tên thiết bị</th>
                                <th>Tên cảm biến</th>
                                <th>Nội dung cảm biến</th>
                                <th>Thời gian bắt đầu</th>
                                <th>Thời gian kết thúc</th>
                                <th>Số lần cảnh báo</th>
                              </tr>
                            </thead>
                            <tbody>
                            </tbody>
                          </table>
                          <table id="tbl_canhbao_ami" class="table table-bordered table-striped canhbaovanhanh"
                            style="width:100%">
                            <thead>
                              <tr>
                                <th>Mã điểm đo - Tên khách hàng</th>
                                <th>STT</th>
                                <th style='display:none'>Mã điểm đo</th>
                                <th style='display:none'>Tên khách hàng</th>
                                <th>Thời điểm xảy ra cảnh báo</th>
                                <th>Thời điểm cảnh báo gần nhất</th>
                                <th>Phân loại cảnh báo</th>
                                <th>Nội dung cảnh báo</th>
                              </tr>
                            </thead>
                            <tbody>
                            </tbody>
