                            <div class="content-body">
                                <!-- row -->
                                <div class="container-fluid">

                                    <!-- Main content -->
                                    <section class="content mt-2">

                                        <!-- Default box -->
                                        <div class="card card-info">
                                            <!-- /.card-header -->
                                            <div class="card-body">

                                                <div class="row">
                                                    <table id="tbl_thietbitruyenthong"
                                                        class="table  table-sk table-bordered table-striped table-hover">
                                                        <thead>
                                                            <tr>
                                                                <th style="width: 50px;">STT</th>
                                                                <th style="text-align:center">Số IMEI</th>
                                                                <th style="text-align:center">IP</th>
                                                                <th style="text-align:center">Port</th>
                                                                <th style="width:110px;text-align:center">Cấu hình</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                        </tbody>

                                                    </table>
                                                </div>
                                            </div>
                                            <!-- /.card-body -->
                                        </div>
                                        <!-- /.card -->
                                        <!-- /.modal thêm mới người dùng-->
                                        <div class="modal fade" id="modal-DIEUKHIEN_DONG">
                                            <div class="modal-dialog modal-xl">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h4 class="modal-title"> CẤU HÌNH ĐIỆN ÁP THẤP</h4>
                                                        <button type="button" class="close" data-bs-dismiss="modal"
                                                            aria-label="Close">
                                                            <span aria-hidden="true">&times;</span>
                                                        </button>
                                                    </div>

                                                    <div class="modal-body">
                                                        <div class="box-default">
                                                            <div class="box-body">
                                                                <hr style="margin:0;" />
                                                                <div class="row">

                                                                    <div id="canhbao_box_th"
                                                                        style="color:blue;  text-align:center"> <span
                                                                            id="id_overlay_nt"><i
                                                                                class="fa fa-circle-o-notch fa-spin"></i></span><br />
                                                                        <h5 id="thongbao_dong"></h5>
                                                                    </div>
                                                                </div>
                                                                <div class="row" style="margin-top: 0px;">
                                                                    <div class="form-group col-lg-6">
                                                                        <label>
                                                                            Thời gian gửi TSVH bình thường (giây)
                                                                            <span class="text-danger">(*)</span>
                                                                        </label>
                                                                        <input type="number"
                                                                            class="form-control istextbox"
                                                                            id="id_time_tsvh_bt" maxlength="20">
                                                                    </div>

                                                                    <div class="form-group col-lg-6">
                                                                        <label>
                                                                            Thời gian gửi TSVH khi điện áp cao/thấp
                                                                            (giây)
                                                                            <span class="text-danger">(*)</span>
                                                                        </label>
                                                                        <input type="number"
                                                                            class="form-control istextbox"
                                                                            id="id_time_tsvh_caothap" maxlength="20">
                                                                    </div>

                                                                </div>

                                                                <div class="row" style="margin-top: 20px;">
                                                                    <div class="form-group col-lg-6">
                                                                        <label>
                                                                            Ngưỡng cảnh báo điện áp thấp (v)
                                                                            <span class="text-danger">(*)</span>
                                                                        </label>
                                                                        <input type="number"
                                                                            class="form-control istextbox"
                                                                            id="id_nguong_canhbao_thap" maxlength="20">
                                                                    </div>

                                                                    <div class="form-group col-lg-6">
                                                                        <label>
                                                                            Giá trị delta cảnh báo điện áp thấp (v)
                                                                            <span class="text-danger">(*)</span>
                                                                        </label>
                                                                        <input type="number"
                                                                            class="form-control istextbox"
                                                                            id="id_delta_thap" maxlength="20"
                                                                            onkeypress="return isNumber(event)">
                                                                    </div>

                                                                </div>


                                                                <div class="row" style="margin-top: 20px;">
                                                                    <div class="form-group col-lg-6">
                                                                        <label>
                                                                            Ngưỡng cảnh báo điện áp cao (v)
                                                                            <span class="text-danger">(*)</span>
                                                                        </label>
                                                                        <input type="number"
                                                                            class="form-control istextbox"
                                                                            id="id_nguong_canhbao_cao" maxlength="20">
                                                                    </div>

                                                                    <div class="form-group col-lg-6">
                                                                        <label>
                                                                            Giá trị delta cảnh báo điện áp cao (v)
                                                                            <span class="text-danger">(*)</span>
                                                                        </label>
                                                                        <input type="number"
                                                                            class="form-control istextbox"
                                                                            id="id_delta_cao" maxlength="20"
                                                                            onkeypress="return isNumber(event)">
                                                                    </div>

                                                                </div>

                                                            </div>
                                                            <!-- /.box-body -->
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <div class="col-lg-3" style="float:right; text-align:right">
                                                            <button type="button" class="btn btn-primary"
                                                                id="btndoc">Đọc thông số</button>
                                                        </div>
                                                        <button type="button" class="btn btn-primary"
                                                            onclick="ThucHien_CauHinh()" id="btnDong">Lưu cấu
                                                            hình</button>
                                                    </div>
                                                </div>
                                                <!-- /.modal-content -->
                                            </div>
                                            <!-- /.modal-dialog -->
                                        </div>
                                        <!-- /.modal -->

                                    </section>
                                    <!-- /.content -->

                                </div>
                            </div>
        </div>
        <!--**********************************
        Content body end
    ***********************************-->
