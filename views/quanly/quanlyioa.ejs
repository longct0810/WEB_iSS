                      <div class="col-md-4">
                        <div class="card card-primary card-outline">
                          <div class="card-header">
                            <div class="row">
                              <div class="col-md-6 col-lg-6 col-6 col-xl-6">
                                <label>Loại IOA </label>
                                <select class="form-control" style="width: 100%;" id="cb_loaiIOA">
                                  <option value="-1">--Chọn loại IOA--</option>
                                  <option value="1">Trạng thái vận hành</option>
                                  <option value="2">Cảnh báo</option>
                                  <option value="3">Thông số vận hành</option>
                                </select>
                              </div>

                              <!-- /.form-group -->
                              <div class="col-md-6 col-lg-6 col-6 col-xl-6" style="margin-top: 31px;">
                                <button type="button" class="btn btn-primary" id="btnSave_LoaiIOA">
                                  Cập nhật loại IOA
                                </button>
                              </div>
                            </div>

                          </div>


                        </div>
                        <!-- /.col -->
                      </div>
                      <div class="col-md-4">
                        <div class="card card-primary card-outline">
                          <div class="card-header">
                            <div class="row">
                              <div class="col-md-6 col-lg-6 col-6 col-xl-6">
                                <label>View IOA </label>
                                <select class="form-control" style="width: 100%;" id="cb_view">
                                  <option value="-1">--Chọn loại hiển thị--</option>
                                  <option value="1">Hiển thị</option>
                                  <option value="0">Không hiển thị</option>
                                </select>
                              </div>

                              <!-- /.form-group -->
                              <div class="col-md-6 col-lg-6 col-6 col-xl-6" style="margin-top: 31px;">
                                <button type="button" class="btn btn-primary" id="btnSave_View">
                                  Cập nhật View
                                </button>
                              </div>
                            </div>

                          </div>


                        </div>
                        <!-- /.col -->
                      </div>
                      <div class="col-md-4">
                        <div class="card card-primary card-outline">
                          <div class="card-header">
                            <div class="row">
                              <div class="col-md-6 col-lg-6 col-6 col-xl-6">
                                <label>Link IOA </label>
                                <select class="select2 form-control" style="width: 100%;" id="cb_link">
                                </select>
                              </div>

                              <!-- /.form-group -->
                              <div class="col-md-6 col-lg-6 col-6 col-xl-6" style="margin-top: 31px;">
                                <button type="button" class="btn btn-primary" id="btnSave_link">
                                  Cập nhật Link
                                </button>
                              </div>
                            </div>

                          </div>


                        </div>
                        <!-- /.col -->
                      </div>
                      <!-- ./row -->
                    </div><!-- /.container-fluid -->
                    <!-- Default box -->
                    <div class="card card-info">
                      <div class="card-header">
                        <h3 class="card-title">Danh sách IOA</h3>
                      </div>
                      <!-- /.card-header -->
                      <div class="card-body">

                        <div class="row">
                          <table id="content_advc"
