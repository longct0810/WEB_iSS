                <style>
                    .wizard-wrap {
                        max-width: 980px;
                        margin: 30px auto;
                    }

                    .wizard-card {
                        border: none;
                        border-radius: 16px;
                        box-shadow: 0 8px 30px rgba(0, 0, 0, .08);
                        overflow: hidden;
                    }

                    .wizard-header {
                        background: #fff;
                        border-bottom: 1px solid #edf2f7;
                        padding: 20px 24px;
                    }

                    .wizard-title {
                        font-size: 24px;
                        font-weight: 700;
                        margin: 0;
                    }

                    .step-bar {
                        display: flex;
                        gap: 12px;
                        flex-wrap: wrap;
                        margin-top: 16px;
                    }

                    .step-item {
                        flex: 1;
                        min-width: 180px;
                        background: #eef2f7;
                        border-radius: 12px;
                        padding: 12px 14px;
                        font-weight: 600;
                        color: #6b7280;
                        border: 1px solid transparent;
                    }

                    .step-item.active {
                        background: #e7f1ff;
                        color: #0d6efd;
                        border-color: #b6d4fe;
                    }

                    .step-item.done {
                        background: #e8f7ee;
                        color: #198754;
                        border-color: #b7e4c7;
                    }

                    .wizard-body {
                        background: #fff;
                        padding: 24px;
                    }

                    .step-panel {
                        display: none;
                    }

                    .step-panel.active {
                        display: block;
                    }

                    .section-box {
                        background: #f8fafc;
                        border: 1px solid #e5e7eb;
                        border-radius: 14px;
                        padding: 18px;
                    }

                    .section-title {
                        font-size: 18px;
                        font-weight: 700;
                        margin-bottom: 16px;
                    }

                    .required {
                        color: #dc3545;
                    }

                    .device-summary,
                    .sensor-summary {
                        background: #f8fafc;
                        border: 1px dashed #cbd5e1;
                        border-radius: 12px;
                        padding: 12px 14px;
                        margin-bottom: 16px;
                    }

                    .ioa-list {
                        border: 1px solid #dee2e6;
                        border-radius: 12px;
                        background: #fff;
                        overflow-y: auto;
                        padding: 10px;
                    }

                    .ioa-row {
                        padding: 10px 12px;
                        border-radius: 10px;
                    }

                    .ioa-row:hover {
                        background: #f8f9fa;
                    }

                    .wizard-footer {
                        background: #fff;
                        border-top: 1px solid #edf2f7;
                        padding: 16px 24px;
                        display: flex;
                        justify-content: space-between;
                        gap: 12px;
                    }

                    .empty-box {
                        text-align: center;
                        color: #6b7280;
                        padding: 24px 12px;
                    }

                    .selected-count {
                        font-size: 14px;
                        color: #374151;
                    }

                    .ioa-tree-wrap {
                        max-height: 420px;
                        overflow-y: auto;
                    }

                    .ioa-tree-row {
                        transition: all .15s ease;
                        background: #fff;
                    }

                    .ioa-tree-row:hover {
                        background: #f8fafc;
                    }

                    .ioa-tree-node .form-check-label {
                        cursor: pointer;
                    }

                    .ioa-toggle {
                        font-weight: 700;
                        line-height: 1;
                        padding: 2px 6px;
                    }

                    .card-body,
                    .step-panel {
                        overflow: hidden;
                        /* hoặc bỏ hẳn */
                    }

                    .tree-box {
                        min-height: 260px;
                        max-height: 360px;
                        overflow-y: auto;
                        border: 1px solid #dee2e6;
                        border-radius: 10px;
                        background: #fff;
                        padding: 10px;
                    }

                    #selected_category_text {
                        font-weight: 500;
                        color: #374151;
                    }
                </style>