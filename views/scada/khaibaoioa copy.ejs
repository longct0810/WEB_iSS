                            <div class="content-body">
                                <!-- row -->
                                <div class="container-fluid">
                                    <div class="wizard-wrap">
                                        <div class="card wizard-card">
                                            <div class="wizard-header">
                                                <h1 class="wizard-title">Thêm thiết bị / cảm biến / IOA</h1>

                                                <div class="step-bar">
                                                    <div class="step-item active" id="stepIndicator1">Bước 1 - Thiết bị
                                                    </div>
                                                    <div class="step-item" id="stepIndicator2">Bước 2 - Cảm biến</div>
                                                    <div class="step-item" id="stepIndicator3">Bước 3 - IOA</div>
                                                </div>
                                            </div>

                                            <div class="wizard-body">
                                                <div id="alertBox" class="alert d-none" role="alert"></div>

                                                <!-- STEP 1 -->
                                                <div class="step-panel active" id="step1">
                                                    <div class="section-box">
                                                        <div class="section-title">Thông tin thiết bị</div>

                                                        <div class="row g-3">
                                                            <div class="col-md-6">
                                                                <label class="form-label">Tên thiết bị <span
                                                                        class="required">*</span></label>
                                                                <input type="text" class="form-control" id="device_name"
                                                                    placeholder="Nhập tên thiết bị">
                                                            </div>

                                                            <div class="col-md-3">
                                                                <label class="form-label">IP thiết bị <span
                                                                        class="required">*</span></label>
                                                                <input type="text" class="form-control" id="device_ip"
                                                                    placeholder="192.168.1.10">
                                                            </div>

                                                            <div class="col-md-3">
                                                                <label class="form-label">Port thiết bị <span
                                                                        class="required">*</span></label>
                                                                <input type="number" class="form-control"
                                                                    id="device_port" placeholder="2404">
                                                            </div>
                                                        </div>

                                                        <hr class="my-4">

                                                        <div class="row g-3">
                                                            <div class="col-md-12">
                                                                <label class="form-label">Danh mục thiết bị <span
                                                                        class="required">*</span></label>

                                                                <input type="hidden" id="device_category_id">
                                                                <input type="hidden" id="device_category_name">

                                                                <div class="mb-2">
                                                                    <div class="form-control bg-light"
                                                                        id="selected_category_text">
                                                                        Chưa chọn danh mục
                                                                    </div>
                                                                </div>

                                                                <div id="device_category_tree" class="tree-box"></div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- STEP 2 -->
                                                <div class="step-panel" id="step2">
                                                    <div class="device-summary">
                                                        <div><strong>Thiết bị vừa tạo:</strong> <span
                                                                id="summary_device_name"></span></div>
                                                        <div><strong>IP:</strong> <span id="summary_device_ip"></span>
                                                        </div>
                                                        <div><strong>Port:</strong> <span
                                                                id="summary_device_port"></span></div>
                                                    </div>

                                                    <div class="section-box">
                                                        <div class="section-title">Thông tin cảm biến</div>

                                                        <div class="row g-3">
                                                            <div class="col-md-5">
                                                                <label class="form-label">Tên cảm biến <span
                                                                        class="required">*</span></label>
                                                                <input type="text" class="form-control" id="sensor_name"
                                                                    placeholder="Nhập tên cảm biến">
                                                            </div>

                                                            <div class="col-md-3">
                                                                <label class="form-label">Giao thức <span
                                                                        class="required">*</span></label>
                                                                <select class="form-select" id="sensor_protocol">
                                                                    <option value="">-- Chọn --</option>
                                                                    <option value="0">IEC104</option>
                                                                    <option value="1">IEC101</option>
                                                                    <option value="2">Modbus</option>
                                                                </select>
                                                            </div>

                                                            <div class="col-md-4">
                                                                <label class="form-label">Type <span
                                                                        class="required">*</span></label>
                                                                <select class="form-select" id="sensor_type">
                                                                    <option value="">-- Chọn loại cảm biến --</option>
                                                                    <option value="7">ADVC</option>
                                                                    <option value="0">Cảm biến khí</option>
                                                                    <option value="1">Cảm biến nhiệt
                                                                    </option>
                                                                    <option value="2">Cảm biến FI</option>
                                                                    <option value="3">Cảm biến độ ẩm
                                                                    </option>
                                                                    <option value="4">Cảnh báo FI</option>
                                                                    <option value="5">Công tơ</option>
                                                                    <option value="6">LBS</option>
                                                                    <option value="8">Din Acrel</option>
                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- STEP 3 -->
                                                <div class="step-panel" id="step3">
                                                    <div class="device-summary">
                                                        <div><strong>Thiết bị:</strong> <span
                                                                id="final_device_name"></span></div>
                                                        <div><strong>Cảm biến:</strong> <span
                                                                id="final_sensor_name"></span></div>
                                                        <div><strong>Giao thức:</strong> <span
                                                                id="final_sensor_protocol"></span></div>
                                                        <div><strong>Type:</strong> <span id="final_sensor_type"></span>
                                                        </div>
                                                    </div>

                                                    <div class="section-box">
                                                        <div class="section-title">Chọn IOA cho cảm biến</div>

                                                        <div class="d-flex gap-2 mb-2 flex-wrap">
                                                            <button type="button"
                                                                class="btn btn-outline-secondary btn-sm"
                                                                id="btnCheckAllIoa">Chọn tất cả</button>
                                                            <button type="button"
                                                                class="btn btn-outline-secondary btn-sm"
                                                                id="btnUncheckAllIoa">Bỏ chọn tất cả</button>
                                                            <button type="button"
                                                                class="btn btn-outline-secondary btn-sm"
                                                                id="btnReloadIoa">Tải lại</button>
                                                        </div>

                                                        <div class="selected-count mb-2">
                                                            Đã chọn: <strong id="selectedIoaCount">0</strong> IOA
                                                        </div>

                                                        <div id="ioaList" class="ioa-list">
                                                            <div class="empty-box">Chưa có dữ liệu IOA</div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="wizard-footer">
                                                <button class="btn btn-outline-secondary" id="btnPrev" disabled>Quay
                                                    lại</button>

                                                <div class="d-flex gap-2">
                                                    <button class="btn btn-outline-danger d-none" id="btnReset">Tạo
                                                        mới</button>
                                                    <button class="btn btn-primary" id="btnNext">Next</button>
                                                    <button class="btn btn-success d-none" id="btnFinish">Hoàn
                                                        tất</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
        </div>

        <!--**********************************
        Content body end
    ***********************************-->
        <%- include('../footer.ejs') %>
