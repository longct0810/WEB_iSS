<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/icons/font-awesome/css/all.min.css">
    <link rel="stylesheet" href="/css/dashboard.css" />
    <link rel="stylesheet" href="/stylesheets/business-ui.css?v=0.5.1" />


    <%- include('../script.ejs') %>
</head>

<body class="business-ui business-ui--shell">
    <div class="app-shell">
        <%- include('../menu_form/sidebar') %>
            <main class="main">
                <%- include('../menu_form/topbar') %>
                    <div class="content-body">
                        <!-- row -->
                        <div class="container-fluid">
                            <div class="wizard-wrap">
                                <div class="card wizard-card">
                                    <div class="wizard-header">
                                        <h1 class="wizard-title">Thêm thiết bị / cảm biến / IOA</h1>

                                        <div class="step-bar">
                                            <div class="step-item active" id="stepIndicator1">Bước 1 - Thiết bị
                                            </div>
                                            <div class="step-item" id="stepIndicator3">Bước 2 - IOA</div>
                                        </div>
                                    </div>

                                    <div class="wizard-body">
                                        <div id="alertBox" class="alert d-none" role="alert"></div>

                                        <!-- STEP 1 -->
                                        <div class="step-panel active" id="step1">
                                            <div class="section-box">
                                                <div class="section-title">Thông tin thiết bị</div>

                                                <div class="row g-3">
                                                    <div class="col-md-6">
                                                        <label class="form-label">Tên thiết bị <span
                                                                class="required">*</span></label>
                                                        <input type="text" class="form-control" id="device_name"
                                                            placeholder="Nhập tên thiết bị">
                                                    </div>

                                                    <div class="col-md-3">
                                                        <label class="form-label">IP thiết bị <span
                                                                class="required">*</span></label>
                                                        <input type="text" class="form-control" id="device_ip"
                                                            placeholder="192.168.1.10">
                                                    </div>

                                                    <div class="col-md-3">
                                                        <label class="form-label">Port thiết bị <span
                                                                class="required">*</span></label>
                                                        <input type="number" class="form-control" id="device_port"
                                                            placeholder="2404">
                                                    </div>
                                                </div>

                                                <hr class="my-4">

                                                <div class="row g-3">
                                                    <div class="col-md-12">
                                                        <label class="form-label">Danh mục thiết bị <span
                                                                class="required">*</span></label>

                                                        <input type="hidden" id="device_category_id">
                                                        <input type="hidden" id="device_category_name">

                                                        <div class="mb-2">
                                                            <div class="form-control bg-light"
                                                                id="selected_category_text">
                                                                Chưa chọn danh mục
                                                            </div>
                                                        </div>

                                                        <div id="device_category_tree" class="tree-box"></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <!-- STEP 3 -->
                                        <div class="step-panel" id="step2">
                                            <div class="device-summary">
                                                <div><strong>Thiết bị vừa tạo:</strong> <span
                                                        id="summary_device_name"></span></div>
                                                <div><strong>IP:</strong> <span id="summary_device_ip"></span>
                                                </div>
                                                <div><strong>Port:</strong> <span id="summary_device_port"></span></div>
                                            </div>

                                            <div class="section-box">
                                                <div class="section-title">Chọn IOA cho cảm biến</div>

                                                <div class="d-flex gap-2 mb-2 flex-wrap">
                                                    <button type="button" class="btn btn-outline-secondary btn-sm"
                                                        id="btnCheckAllIoa">Chọn tất cả</button>
                                                    <button type="button" class="btn btn-outline-secondary btn-sm"
                                                        id="btnUncheckAllIoa">Bỏ chọn tất cả</button>
                                                    <button type="button" class="btn btn-outline-secondary btn-sm"
                                                        id="btnReloadIoa">Tải lại</button>
                                                </div>

                                                <div class="selected-count mb-2">
                                                    Đã chọn: <strong id="selectedIoaCount">0</strong> IOA
                                                </div>

                                                <div id="ioaList" class="ioa-list">
                                                    <div class="empty-box">Chưa có dữ liệu IOA</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="wizard-footer">
                                        <button class="btn btn-outline-secondary" id="btnPrev" disabled>Quay
                                            lại</button>

                                        <div class="d-flex gap-2">
                                            <button class="btn btn-outline-danger d-none" id="btnReset">Tạo
                                                mới</button>
                                            <button class="btn btn-primary" id="btnNext">Next</button>
                                            <button class="btn btn-success d-none" id="btnFinish">Hoàn
                                                tất</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- DANH SÁCH THIẾT BỊ -->
                            <div class="card wizard-card mt-4">
                                <div
                                    class="wizard-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                                    <h2 class="wizard-title mb-0" style="font-size:20px;">Danh sách thiết bị đã
                                        thêm</h2>
                                    <button class="btn btn-outline-primary btn-sm" id="btnReloadDeviceList">Tải
                                        lại danh sách</button>
                                </div>

                                <div class="wizard-body">
                                    <div class="table-responsive">
                                        <table class="table table-bordered table-hover align-middle mb-0"
                                            id="tbl_device_list">
                                            <thead class="table-light">
                                                <tr>
                                                    <th style="width:70px">STT</th>
                                                    <th>Tên thiết bị</th>
                                                    <th style="width:180px">IP</th>
                                                    <th style="width:100px">Port</th>
                                                    <th>Danh mục</th>
                                                    <th style="width:260px">Thao tác</th>
                                                </tr>
                                            </thead>
                                            <tbody id="deviceListBody">
                                                <tr>
                                                    <td colspan="6" class="text-center">Đang tải dữ liệu</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="modal fade" id="modalEditIoa" tabindex="-1" role="dialog">
                        <div class="modal-dialog modal-dialog-centered" role="document">
                            <div class="modal-content">

                                <div class="modal-header">
                                    <h5 class="modal-title">Sửa IOA</h5>
                                    <button type="button" class="close" data-bs-dismiss="modal">
                                        <span>&times;</span>
                                    </button>
                                </div>

                                <div class="modal-body">
                                    <input type="hidden" id="edit_ioa_code">
                                    <input type="hidden" id="edit_ioa_type">
                                    <input type="hidden" id="edit_ioa_tencapcha">
                                    <div id="alertBoxIOa" class="alert d-none" role="alert"></div>
                                    <div class="form-group">
                                        <label>Tên IOA</label>
                                        <input type="text" class="form-control" id="edit_ioa_ten">
                                    </div>

                                    <div class="form-group" id="groupIoaDiaChi">
                                        <label>IOA địa chỉ</label>
                                        <input type="number" class="form-control" id="edit_ioa_diachi">
                                    </div>
                                    <div class="form-group" id="groupIoaScale">
                                        <label>Scale</label>
                                        <input type="number" class="form-control" id="edit_ioa_scale">
                                    </div>
                                </div>

                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                        Đóng
                                    </button>
                                    <button type="button" class="btn btn-primary" id="btnSaveEditIoa">
                                        Cập nhật
                                    </button>
                                </div>

                            </div>
                        </div>
                    </div>

            </main>

    </div>


    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/jstree@3.3.17/dist/themes/default/style.min.css">
    <script src="./vendor/jquery-nice-select/js/jquery.nice-select.min.js"></script>
    <script src="./vendor/select2/js/select2.full.min.js"></script>
    <script src="./javascripts/plugins-init/select2-init.js"></script>
    <script src="./vendor/pickadate/picker.js"></script>
    <script src="./vendor/pickadate/picker.time.js"></script>
    <script src="./vendor/pickadate/picker.date.js"></script>
    <script src="./vendor/toastr/js/toastr.min.js"></script>
    <script src="./javascripts/plugins-init/toastr-init.js"></script>
    <script src="../javascripts/fnTime.js"></script>
    <script src="../javascripts/moment.js"></script>
    <!-- DataTables Buttons JS -->
    <script src="./vendor/datatables/js/jquery.dataTables.min.js"></script>
    <script src="./vendor/datatables/js/dataTables.buttons.min.js"></script>
    <script src="./vendor/datatables/js/dataTables.rowGroup.js"></script>
    <script src="./vendor/datatables/js/jszip.min.js"></script>
    <script src="./vendor/datatables/js/buttons.html5.min.js"></script>
    <!-- Chartist -->
    <script src="./vendor/chart.js/Chart.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jstree@3.3.17/dist/jstree.min.js"></script>
    <script src="../javascripts/scada/thietbi_cambien.js"></script>
    <link rel="stylesheet" href="./vendor/toastr/css/toastr.min.css">
    <style>
        /* ===== KHAI BÁO IOA - THEME ĐỒNG BỘ DASHBOARD SMARTGRID ===== */
        .content-body {
            padding: 18px 0 24px;
        }

        .container-fluid {
            width: 100%;
            max-width: 100%;
            padding: 0;
        }

        .wizard-wrap {
            max-width: 1180px;
            margin: 28px auto 0;
        }

        .wizard-card,
        .card.wizard-card {
            background: linear-gradient(180deg, rgba(14, 43, 76, .94), rgba(7, 25, 48, .92));
            border: 1px solid rgba(55, 150, 255, .34);
            border-radius: 16px;
            color: var(--text);
            box-shadow: 0 18px 60px rgba(0, 0, 0, .45), inset 0 1px 0 rgba(255, 255, 255, .045);
            overflow: hidden;
            backdrop-filter: blur(14px);
        }

        .wizard-header {
            background:
                radial-gradient(circle at 12% 0%, rgba(34, 167, 255, .18), transparent 34%),
                linear-gradient(180deg, rgba(13, 41, 74, .96), rgba(8, 29, 54, .92));
            border-bottom: 1px solid rgba(80, 155, 225, .25);
            padding: 22px 24px 18px;
        }

        .wizard-title {
            font-size: 22px;
            font-weight: 800;
            letter-spacing: .2px;
            margin: 0;
            color: #f2f8ff;
            text-shadow: 0 0 18px rgba(34, 167, 255, .55);
        }

        .step-bar {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin-top: 18px;
        }

        .step-item {
            flex: 1;
            min-width: 220px;
            background: rgba(9, 39, 69, .88);
            border: 1px solid rgba(65, 133, 198, .35);
            border-radius: 12px;
            padding: 12px 14px;
            color: #9fb6cc;
            font-weight: 700;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, .035);
        }

        .step-item.active {
            background: linear-gradient(90deg, rgba(30, 107, 167, .9), rgba(13, 49, 86, .9));
            border-color: rgba(91, 193, 255, .75);
            color: #eaf6ff;
            box-shadow: inset 3px 0 0 #5bc1ff, 0 0 20px rgba(34, 167, 255, .18);
        }

        .step-item.done {
            background: rgba(23, 86, 57, .58);
            border-color: rgba(98, 255, 71, .42);
            color: var(--green);
        }

        .wizard-body {
            background: transparent;
            padding: 24px;
        }

        .step-panel {
            display: none;
            overflow: visible;
        }

        .step-panel.active {
            display: block;
        }

        .section-box {
            background: linear-gradient(180deg, rgba(10, 32, 58, .82), rgba(6, 24, 45, .86));
            border: 1px solid rgba(83, 144, 205, .35);
            border-radius: 14px;
            padding: 20px;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, .035);
        }

        .section-title {
            font-size: 17px;
            font-weight: 800;
            margin-bottom: 18px;
            color: #eaf4ff;
            text-shadow: 0 0 14px rgba(34, 167, 255, .35);
        }

        .form-label {
            color: #a8d6ff;
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .required {
            color: #ff4d4f;
        }

        .form-control,
        .form-select {
            min-height: 40px;
            background: rgba(4, 16, 31, .72) !important;
            color: #eaf4ff !important;
            border: 1px solid rgba(83, 144, 205, .48);
            border-radius: 9px;
            box-shadow: none;
        }

        .form-control::placeholder {
            color: #6f8eaa;
        }

        .form-control:focus,
        .form-select:focus {
            background: rgba(5, 23, 44, .92) !important;
            color: #fff !important;
            border-color: #5bc1ff;
            box-shadow: 0 0 0 .2rem rgba(34, 167, 255, .15);
        }

        #selected_category_text {
            font-weight: 700;
            color: #dceeff !important;
            background: rgba(6, 28, 52, .92) !important;
            border-color: rgba(83, 144, 205, .48);
        }

        hr {
            border-color: rgba(83, 144, 205, .35);
            opacity: 1;
        }

        .tree-box,
        .ioa-list {
            min-height: 260px;
            max-height: 390px;
            overflow-y: auto;
            border: 1px solid rgba(83, 144, 205, .38);
            border-radius: 12px;
            background: rgba(3, 13, 25, .58);
            padding: 10px;
        }

        .tree-box::-webkit-scrollbar,
        .ioa-list::-webkit-scrollbar {
            width: 8px;
        }

        .tree-box::-webkit-scrollbar-thumb,
        .ioa-list::-webkit-scrollbar-thumb {
            background: rgba(91, 193, 255, .45);
            border-radius: 999px;
        }

        /* jstree dark */
        .jstree-default .jstree-anchor {
            color: #cbe8ff;
            border-radius: 7px;
            padding: 2px 6px;
            height: 28px;
            line-height: 24px;
        }

        .jstree-default .jstree-anchor:hover,
        .jstree-default .jstree-clicked {
            background: rgba(34, 167, 255, .16);
            color: #fff;
            box-shadow: none;
        }

        .device-summary,
        .sensor-summary {
            background: rgba(7, 31, 56, .78);
            border: 1px dashed rgba(91, 193, 255, .45);
            border-radius: 12px;
            padding: 13px 15px;
            margin-bottom: 16px;
            color: #dceeff;
        }

        .selected-count {
            font-size: 14px;
            color: #b7cce2;
        }

        .ioa-row,
        .ioa-tree-row {
            padding: 10px 12px;
            border-radius: 10px;
            background: rgba(9, 31, 56, .68);
            color: #dceeff;
            border: 1px solid rgba(83, 144, 205, .18);
            transition: .16s ease;
        }

        .ioa-row:hover,
        .ioa-tree-row:hover {
            background: rgba(30, 107, 167, .28);
            border-color: rgba(91, 193, 255, .42);
        }

        .ioa-tree-wrap {
            max-height: 420px;
            overflow-y: auto;
        }

        .ioa-tree-node .form-check-label {
            cursor: pointer;
            color: #dceeff;
        }

        .ioa-toggle {
            font-weight: 800;
            line-height: 1;
            padding: 2px 6px;
            color: #171622;
        }

        .empty-box {
            text-align: center;
            color: #9fb6cc;
            padding: 24px 12px;
        }

        .wizard-footer {
            background: rgba(6, 19, 38, .82);
            border-top: 1px solid rgba(80, 155, 225, .25);
            padding: 16px 24px;
            display: flex;
            justify-content: space-between;
            gap: 12px;
        }

        .btn {
            border-radius: 9px;
            font-weight: 700;
            padding: 8px 13px;
        }

        .btn-primary,
        .btn-success {
            border: 1px solid rgba(91, 193, 255, .5);
            background: linear-gradient(180deg, rgba(28, 88, 140, .95), rgba(8, 31, 58, .96));
            color: #dff3ff;
        }

        .btn-primary:hover,
        .btn-success:hover,
        .btn-outline-primary:hover {
            border-color: #63c7ff;
            box-shadow: 0 0 18px rgba(39, 172, 255, .28);
        }

        .btn-outline-secondary,
        .btn-outline-primary,
        .btn-outline-danger {
            background: rgba(7, 31, 56, .8);
            border: 1px solid rgba(83, 144, 205, .45);
            color: #dceeff;
        }

        .btn-outline-danger {
            border-color: rgba(255, 77, 79, .55);
            color: #ff9b9d;
        }

        .btn:disabled {
            opacity: .45;
            cursor: not-allowed;
        }


        .text-center {
            color: #b7cce2 !important;
        }

        .btn-action-group {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        @media (max-width: 1200px) {
            .wizard-wrap {
                max-width: 100%;
                margin: 18px 0 0;
            }
        }

        @media (max-width: 768px) {

            .wizard-body,
            .wizard-header,
            .wizard-footer {
                padding: 16px;
            }

            .step-item {
                min-width: 100%;
            }

            .wizard-footer {
                flex-direction: column;
            }

            .wizard-footer>.d-flex {
                justify-content: flex-end;
            }
        }

        /* ===== Row thông tin thiết bị ===== */

        .device-form-row {
            display: grid;
            grid-template-columns: 2fr 1.5fr 0.8fr;
            gap: 16px;
            margin-bottom: 18px;
        }

        .modal-title {
            color: #0f0e0e;
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }

        .form-group label {
            color: #0f0e0e;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 6px;
        }

        .form-group label span {
            color: #ff4d4f;
        }

        .form-group input {
            height: 42px;

            background: #071c33;
            border: 1px solid #1e4d79;
            border-radius: 10px;

            color: #eaf4ff;
            font-size: 14px;

            padding: 0 12px;

            transition: .25s;
        }

        .form-group input:focus {
            outline: none;
            border-color: #4fb7ff;
            box-shadow: 0 0 12px rgba(79, 183, 255, .25);
        }

        .wizard-wrap {
            max-width: 980px;
            margin: 30px auto;
        }

        .wizard-card {
            border: none;
            border-radius: 16px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, .08);
            overflow: hidden;
        }


        .wizard-title {
            font-size: 24px;
            font-weight: 700;
            margin: 0;
        }

        .step-bar {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin-top: 16px;
        }

        .step-item {
            flex: 1;
            min-width: 180px;
            background: #eef2f7;
            border-radius: 12px;
            padding: 12px 14px;
            font-weight: 600;
            color: #6b7280;
            border: 1px solid transparent;
        }

        .step-item.active {
            background: #e7f1ff;
            color: #0d6efd;
            border-color: #b6d4fe;
        }

        .step-item.done {
            background: #e8f7ee;
            color: #198754;
            border-color: #b7e4c7;
        }


        .step-panel {
            display: none;
        }

        .step-panel.active {
            display: block;
        }


        .required {
            color: #dc3545;
        }



        .ioa-row {
            padding: 10px 12px;
            border-radius: 10px;
        }

        .ioa-row:hover {
            background: #f8f9fa;
        }

        .empty-box {
            text-align: center;
            color: #6b7280;
            padding: 24px 12px;
        }

        .selected-count {
            font-size: 14px;
            color: #374151;
        }

        .ioa-tree-wrap {
            max-height: 420px;
            overflow-y: auto;
        }



        .ioa-tree-node .form-check-label {
            cursor: pointer;
        }

        .ioa-toggle {
            font-weight: 700;
            line-height: 1;
            padding: 2px 6px;
        }

        .card-body,
        .step-panel {
            overflow: hidden;
            /* hoặc bỏ hẳn */
        }


        #selected_category_text {
            font-weight: 500;
            color: #374151;
        }

        .btn-action-group {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .btn-edit-ioa {
            opacity: .6;
            transition: .2s;
        }

        .ioa-tree-row:hover .btn-edit-ioa {
            opacity: 1;
        }

        .btn-edit-ioa:hover {
            color: #0d6efd !important;
            transform: scale(1.15);
        }

        table.dataTable thead th,
        .table thead th {
            border-bottom: 1px solid #78aad233 !important;
            border-right: 1px solid #78aad233 !important;
            text-align: center;
            vertical-align: middle;
            background-color: #4885ed !important;
            color: #fff;
        }

        
    </style>
