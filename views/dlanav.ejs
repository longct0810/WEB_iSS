  :root {
    --sidebar-width-open: 345px;
    --sidebar-width-close: 72px;
    --sidebar-brand-height: 65px;
  }

  .dlabnav {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 6;
    width: var(--sidebar-width-open) !important;
    min-width: var(--sidebar-width-open) !important;
    max-width: var(--sidebar-width-open) !important;
    height: 100vh;
    transition: width .25s ease, min-width .25s ease, max-width .25s ease;
    overflow: hidden;
    background: #fff !important;
    color: #1f2937;
    box-shadow: 4px 0 22px rgba(15, 23, 42, 0.08);
    border-right: 1px solid #e5e7eb;
  }

  .dlabnav.collapsed {
    width: var(--sidebar-width-close) !important;
    min-width: var(--sidebar-width-close) !important;
    max-width: var(--sidebar-width-close) !important;
  }

  .sidebar-brand {
    height: var(--sidebar-brand-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 18px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    background: var(--primary);
  }

  .sidebar-brand-logo {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-decoration: none;
  }

  .sidebar-brand-logo img {
    display: block;
    max-width: 140px;
    width: 100%;
    height: auto;
    transition: max-width .25s ease, opacity .25s ease, transform .25s ease;
  }

  .sidebar-toggle-btn {
    flex: 0 0 38px;
    width: 38px;
    height: 38px;
    border: none;
    border-radius: 10px;
    background: #fff;
    color: var(--app-primary);
    box-shadow: 0 4px 12px rgba(0, 0, 0, .15);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .sidebar-toggle-btn i {
    font-size: 18px;
    pointer-events: none;
  }

  .dlabnav-scroll {
    height: calc(100vh - var(--sidebar-brand-height));
    overflow-y: auto;
    overflow-x: hidden;
  }

  .tree_home_ul {
    padding-bottom: 12px;
  }

  .dlabnav.collapsed .sidebar-brand {
    justify-content: center;
    padding: 18px 8px;
  }

  .dlabnav.collapsed .sidebar-brand-logo {
    display: none;
  }

  .dlabnav.collapsed .search-area,
  .dlabnav.collapsed .tab-content,
  .dlabnav.collapsed .copyright,
  .dlabnav.collapsed #menu {
    display: none !important;
  }

  .dlabnav.collapsed .dlabnav-scroll {
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .sidebar-search {
      width: calc(100% - 28px) !important;
      margin: 12px 14px !important;
      padding: 0 !important;

      display: flex !important;
      flex-wrap: nowrap !important;
      align-items: stretch !important;
    }

    .sidebar-search input.form-control {
      flex: 1 1 auto !important;
      width: auto !important;
      min-width: 0 !important;

      height: 38px !important;
      border-radius: 8px 0 0 8px !important;
      border-right: 0 !important;
    }

    .sidebar-search .input-group-text {
      flex: 0 0 42px !important;
      width: 42px !important;
      min-width: 42px !important;
      height: 38px !important;

      padding: 0 !important;
      border-radius: 0 8px 8px 0 !important;

      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
    }

    .sidebar-search .input-group-text a {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
    }
  }
</style>

