                                <div class="col-lg-12"
                                    style="text-align:center; font-weight:bold; margin:0px 10px 0px 0px">
                                    THÔNG TIN ĐIỂM ĐO</div>
                            </div>
                            <div class="row" style="margin: 10px 0;">
                                <div class="form-group col-lg-6 col-xl-6 col-md-12 col-sm-12" style="margin: 5px 0;">
                                    <div class="input-group input-primary">
                                        <span class="input-group-text"> Mã điểm đo (*)</span>
                                        <input type="text" pattern="^[a-zA-Z0-9_.-]*$" trim class="form-control"
                                            id="edit_MaDiemDo" maxlength="255">
                                    </div>
                                </div>


                                <div class="form-group  col-lg-6 col-xl-6 col-md-12 col-sm-12" style="margin:5px 0;">
                                    <div class="input-group input-primary">
                                        <span class="input-group-text" style="width: 120px;">Loại pha</span>
                                        <select id="edit_LoaiPha" class="form-control">
                                            <option value="1">1 pha 1 giá</option>
                                            <option value="13">1 pha 3 giá</option>
                                            <option value="31">3 pha 1 giá</option>
                                            <option value="3">3 pha 3 giá</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group  col-lg-6 col-xl-6 col-md-12 col-sm-12" style="margin: 5px 0;">
                                    <div class="input-group input-primary">
                                        <span class="input-group-text" style="width: 120px;">Mã trạm</span>
                                        <input type="text" class="form-control" id="edit_matram" maxlength="100">
                                    </div>
                                </div>
                                <div class="form-group  col-lg-6 col-xl-6 col-md-12 col-sm-12" style="margin: 5px 0;">
                                    <div class="input-group input-primary">
                                        <span class="input-group-text" style="width: 120px;">Mã cột</span>
                                        <input type="text" class="form-control" id="edit_macot" maxlength="500">
                                    </div>
                                </div>
                                <div class="form-group  col-lg-6 col-xl-6 col-md-12 col-sm-12" style="margin: 5px 0;">
                                    <div class="input-group input-primary">
                                        <span class="input-group-text" style="width: 120px;">Sổ ghi</span>
                                        <input type="text" class="form-control" id="edit_soghi" maxlength="100">
                                    </div>
                                </div>
                                <div class="form-group  col-lg-6 col-xl-6 col-md-12 col-sm-12" style="margin: 5px 0;">
                                    <div class="input-group input-primary">
                                        <span class="input-group-text" style="width: 120px;">Ghi chú</span>
                                        <input type="text" class="form-control" id="edit_ghichu_kh" maxlength="255">
                                    </div>
                                </div>
                                <div class="form-group  col-lg-6 col-xl-6 col-md-12 col-sm-12" style="margin: 5px 0;">
                                    <div class="input-group input-primary">
                                        <span class="input-group-text" style="width: 120px;">DIN điều khiển</span>
                                        <input type="text" class="form-control" id="edit_din_dk_kh"
                                            placeholder="Nhập imei" maxlength="16">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- /.box-body -->

                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default pull-left" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" onclick="SuaThongTin_diemdo()">Lưu</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
</div>