  <div id="powerAiAlertBackdrop" class="power-ai-alert-backdrop" aria-hidden="true"></div>
  <aside id="powerAiAlertDetail" class="power-ai-alert-detail" aria-hidden="true"
    aria-labelledby="powerAiAlertDetailTitle" role="dialog" aria-modal="true">
    <div class="power-ai-alert-detail-head">
      <div>
        <span class="power-ai-eyebrow">SỰ KIỆN POWERAI</span>
        <h3 id="powerAiAlertDetailTitle">Chi tiết cảnh báo</h3>
      </div>
      <button type="button" id="powerAiAlertDetailClose" aria-label="Đóng chi tiết cảnh báo">×</button>
    </div>
    <div id="powerAiAlertDetailBody" class="power-ai-alert-detail-body"></div>
  </aside>

  <div id="powerAiForecastBackdrop" class="power-ai-alert-backdrop" aria-hidden="true"></div>
  <aside id="powerAiForecastDetail" class="power-ai-alert-detail power-ai-forecast-detail"
    aria-hidden="true" aria-labelledby="powerAiForecastDetailTitle"
    role="dialog" aria-modal="true">
    <div class="power-ai-alert-detail-head">
      <div>
        <span class="power-ai-eyebrow">PHÂN TÍCH POWERAI</span>
        <h3 id="powerAiForecastDetailTitle">Diễn giải dự báo 24 giờ</h3>
      </div>
      <button type="button" id="powerAiForecastDetailClose" aria-label="Đóng diễn giải dự báo">×</button>
    </div>
    <div id="powerAiForecastDetailBody" class="power-ai-alert-detail-body"></div>
  </aside>

  <div id="powerAiHealthBackdrop" class="power-ai-alert-backdrop" aria-hidden="true"></div>
  <aside id="powerAiHealthDetail" class="power-ai-alert-detail power-ai-health-detail-modal"
    aria-hidden="true" aria-labelledby="powerAiHealthDetailTitle"
    role="dialog" aria-modal="true">
    <div class="power-ai-alert-detail-head">
      <div>
        <span class="power-ai-eyebrow">PHÂN TÍCH POWERAI</span>
        <h3 id="powerAiHealthDetailTitle">Diễn giải sức khỏe thiết bị</h3>
      </div>
      <button type="button" id="powerAiHealthDetailClose" aria-label="Đóng diễn giải sức khỏe">×</button>
    </div>
    <div id="powerAiHealthDetailBody" class="power-ai-alert-detail-body"></div>
  </aside>

  <button type="button" id="powerAiChatToggle" class="power-ai-chat-toggle"
    aria-label="Mở trợ lý PowerAI" aria-expanded="false">
    <i class="fas fa-robot"></i>
    <span>Trợ lý AI</span>
  </button>

  <aside id="powerAiChatPanel" class="power-ai-chat-panel" aria-hidden="true"
    role="dialog" aria-labelledby="powerAiChatTitle">
    <div class="power-ai-chat-head">
      <div>
        <i class="fas fa-robot"></i>
        <span>
          <b id="powerAiChatTitle">Trợ lý AI iSS</b>
          <small><span id="ollamaChatStatus" class="ollama-chat-status checking">Đang kiểm tra AI</span> · <span id="powerAiChatDevice">Chưa chọn thiết bị</span></small>
        </span>
      </div>
      <div class="power-ai-chat-head-actions">
        <button type="button" id="powerAiChatReset" title="Xóa hội thoại" aria-label="Xóa hội thoại"><i class="fas fa-redo-alt"></i></button>
        <button type="button" id="powerAiChatClose" aria-label="Đóng trợ lý">×</button>
      </div>
    </div>

    <div id="powerAiChatMessages" class="power-ai-chat-messages" aria-live="polite">
      <div class="power-ai-message assistant power-ai-chat-welcome">
        <span class="power-ai-chat-message-label"><i class="fas fa-robot"></i> Trợ lý AI</span>
        <b>Xin chào, tôi có thể hỗ trợ bạn</b>
        <span>Kiểm tra nhanh tình trạng vận hành của thiết bị đang chọn.</span>
      </div>
    </div>

    <div class="power-ai-chat-suggestions">
      <button type="button" data-question="Sức khỏe thiết bị hiện tại thế nào?"><i class="fas fa-heartbeat"></i> Sức khỏe</button>
      <button type="button" data-question="Thiết bị có cảnh báo hoặc bất thường nào?"><i class="fas fa-bell"></i> Cảnh báo</button>
      <button type="button" data-question="Cho tôi biết thông số điện mới nhất"><i class="fas fa-tachometer-alt"></i> Thông số</button>
      <button type="button" data-question="Dự báo rủi ro sự cố trong 24 giờ"><i class="fas fa-chart-line"></i> Dự báo</button>
    </div>

    <form id="powerAiChatForm" class="power-ai-chat-form">
      <label class="sr-only" for="powerAiChatInput">Câu hỏi dành cho trợ lý PowerAI</label>
      <input id="powerAiChatInput" type="text" maxlength="1000"
        placeholder="Nhập câu hỏi về thiết bị..." autocomplete="off">
      <button type="submit" aria-label="Gửi câu hỏi">
        <i class="fas fa-paper-plane"></i>
      </button>
    </form>
