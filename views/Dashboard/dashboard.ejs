              <div class="thd-card-footer">
                <span><i class="fas fa-broadcast-tower"></i> Cập nhật từ socket</span>
                <time id="realtimeUUpdated">--</time>
              </div>
            </div>

            <div class="panel chart-card thd-card realtime-electrical-card">
              <div class="thd-card-head">
                <div>
                  <span class="thd-eyebrow">DỮ LIỆU THỜI GIAN THỰC</span>
                  <h3>Dòng điện ba pha</h3>
                </div>
                <span class="thd-limit">Đơn vị A</span>
              </div>
              <div class="thd-stats realtime-phase-stats">
                <span>IA <b id="realtimeIA">--</b></span>
                <span>IB <b id="realtimeIB">--</b></span>
                <span>IC <b id="realtimeIC">--</b></span>
                <span class="thd-chart-status" id="realtimeIStatus">Chờ dữ liệu</span>
              </div>
              <div class="card-body">
                <canvas id="realtimeCurrentChart" role="img"
                  aria-label="Biểu đồ dòng điện realtime ba pha"></canvas>
              </div>
              <div class="thd-card-footer">
                <span><i class="fas fa-broadcast-tower"></i> Cập nhật từ socket</span>
                <time id="realtimeIUpdated">--</time>
