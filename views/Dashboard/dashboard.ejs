                <span><i class="fas fa-clock"></i> Dữ liệu gần nhất</span>
                <time id="thdUUpdated">--</time>
              </div>
            </div>
            <div class="panel chart-card thd-card">
              <div class="thd-card-head">
                <div>
                  <span class="thd-eyebrow">CHẤT LƯỢNG ĐIỆN NĂNG</span>
                  <h3>THD dòng điện</h3>
                </div>
                <span class="thd-limit">Tham chiếu ≤ 8%</span>
              </div>
              <div class="thd-stats">
                <span>Trung bình <b id="thdIAvg">--</b></span>
                <span>Cao nhất <b id="thdIMax">--</b></span>
                <span class="thd-chart-status" id="thdIStatus">Chờ dữ liệu</span>
              </div>
              <div class="card-body" id="chartLineChart_I">
                <canvas id="myLineChart_I" style="height: 300px;" role="img"
                  aria-label="Biểu đồ THD dòng điện ba pha">
                  Trình duyệt không hỗ trợ biểu đồ THD dòng điện.
                </canvas>
              </div>
              <div class="thd-card-footer">
                <span><i class="fas fa-clock"></i> Dữ liệu gần nhất</span>
                <time id="thdIUpdated">--</time>
              </div>
            </div>
          </section>

          <section class="bottom-grid realtime-electrical-grid" aria-label="Biểu đồ điện realtime">
            <div class="panel chart-card thd-card realtime-electrical-card">
