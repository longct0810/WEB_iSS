<div class="m11-top-grid">
  <section class="panel m11-demand-panel">
    <div class="panel-head"><h2>Dự báo nhu cầu điện năng (GWh)</h2></div>
    <div class="panel-body"><div id="m11-demand-chart"></div></div>
  </section>
  <section class="panel m11-coal-panel">
    <div class="panel-head"><h2>Dự báo tiêu thụ than (nghìn tấn)</h2></div>
    <div class="panel-body"><div id="m11-coal-chart"></div></div>
  </section>
  <section class="panel m11-cost-panel">
    <div class="panel-head"><h2>Dự báo chi phí năng lượng (tỷ VNĐ)</h2></div>
    <div class="panel-body"><div id="m11-cost-chart"></div></div>
  </section>
</div>

<div class="m11-middle-grid">
  <section class="panel m11-energy-types-panel">
    <div class="panel-head"><h2>Dự báo theo loại năng lượng (2025)</h2></div>
    <div id="m11-energy-types"></div>
  </section>
  <section class="panel m11-scenarios-panel">
    <div class="panel-head"><h2>Kịch bản &amp; So sánh (What-if)</h2></div>
    <div id="m11-scenarios"></div>
  </section>
  <section class="panel m11-assumptions-panel">
    <div class="panel-head"><h2>Giả định chính cho dự báo</h2></div>
    <div class="panel-body" id="m11-assumptions"></div>
  </section>
</div>

<div class="m11-bottom-grid">
  <section class="panel m11-sec-panel">
    <div class="panel-head"><h2>Dự báo cường độ năng lượng (SEC)</h2></div>
    <div class="panel-body"><div id="m11-sec-chart"></div></div>
  </section>
  <section class="panel m11-planning-panel">
    <div class="panel-head"><h2>Quy trình lập kế hoạch năng lượng</h2></div>
    <div class="panel-body" id="m11-planning-steps"></div>
  </section>
  <section class="panel m11-documents-panel">
    <div class="panel-head"><h2>Báo cáo liên quan</h2></div>
    <div class="panel-body" id="m11-documents"></div>
  </section>
</div>
