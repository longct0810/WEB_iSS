<div class="m9-top-grid">
  <section class="panel m9-periodic-panel">
    <div class="panel-head"><h2>Danh sách báo cáo định kỳ</h2></div>
    <div id="m9-periodic-reports"></div>
  </section>
  <section class="panel m9-trend-panel">
    <div class="panel-head"><h2>Xu hướng các chỉ số chính qua thời gian</h2></div>
    <div class="panel-body">
      <div id="m9-trend-tabs" class="m9-mini-tabs"></div>
      <div id="m9-trend-chart"></div>
    </div>
  </section>
  <section class="panel m9-category-panel">
    <div class="panel-head"><h2>Cơ cấu báo cáo theo nhóm</h2></div>
    <div class="panel-body"><div id="m9-report-categories"></div></div>
  </section>
</div>

<div class="m9-middle-grid">
  <section class="panel m9-template-panel">
    <div class="panel-head"><h2>Mẫu báo cáo tiêu biểu</h2><button class="m9-link" data-action="m9-show-templates">Xem tất cả mẫu báo cáo <i class="bi bi-arrow-right"></i></button></div>
    <div class="panel-body"><div id="m9-templates"></div></div>
  </section>
  <section class="panel m9-esg-panel">
    <div class="panel-head"><h2>Báo cáo phục vụ công bố ESG</h2></div>
    <div id="m9-esg-reports"></div>
  </section>
  <section class="panel m9-export-panel">
    <div class="panel-head"><h2>Tùy chỉnh &amp; Xuất báo cáo</h2></div>
    <div class="panel-body" id="m9-export-config"></div>
  </section>
</div>

<div class="m9-bottom-grid">
  <section class="panel m9-history-panel">
    <div class="panel-head"><h2>Lịch sử báo cáo</h2></div>
    <div id="m9-history"></div>
  </section>
  <section class="panel m9-notice-panel">
    <div class="panel-head"><h2>Thông báo &amp; Nhắc nhở báo cáo</h2></div>
    <div class="panel-body" id="m9-notifications"></div>
  </section>
  <section class="panel m9-sharing-panel">
    <div class="panel-head"><h2>Liên kết &amp; Chia sẻ</h2></div>
    <div class="panel-body" id="m9-sharing"></div>
  </section>
</div>
