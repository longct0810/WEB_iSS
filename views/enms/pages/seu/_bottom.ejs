<div class="m4-bottom-grid">
  <section class="panel m4-compare-panel">
    <div class="panel-head"><h2>So sánh EnPI giữa các kỳ</h2></div>
    <div id="m4-compare-filters" class="m4-compare-filters"></div>
    <div id="m4-compare-chart" class="m4-compare-chart"></div>
  </section>

  <section class="panel m4-potential-panel">
    <div class="panel-head"><h2>Top 5 SEU có tiềm năng cải thiện</h2></div>
    <div id="m4-potential-table"></div>
    <div class="m4-potential-action"><button class="btn primary" data-action="m4-open-savings">Xem danh sách cơ hội tiết kiệm năng lượng <i class="bi bi-chevron-right"></i></button></div>
  </section>

  <section class="panel m4-performance-panel">
    <div class="panel-head"><h2>Chỉ số hiệu suất khác</h2></div>
    <div id="m4-performance-table"></div>
    <div class="m4-performance-actions">
      <button class="btn" data-action="m4-config-enpi"><i class="bi bi-gear"></i> Cấu hình EnPI/EnB</button>
      <button class="btn" data-action="m4-export-enpi"><i class="bi bi-download"></i> Xuất báo cáo EnPI</button>
    </div>
  </section>
</div>
