<%
const model = diagramData[type];
const dimensions = {overview:[1000,410],realtime:[1000,350],boiler:[1440,220],fuel:[1000,285],emissions:[1000,220],seu:[1440,320],twin:[1000,135]};
const [w,h] = dimensions[type];
const escapeXml = value => String(value).replace(/[&<>"']/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
const text = (x,y,label,cls='diagram-label',anchor='start') => `<text x="${x}" y="${y}" class="${cls}" text-anchor="${anchor}">${escapeXml(label)}</text>`;
const value = (x,y,key,unit='',decimals=0,cls='diagram-value',anchor='start',prefix='') => {
 const initial=model[key];
 const display=typeof initial==='number'?new Intl.NumberFormat('vi-VN',{minimumFractionDigits:decimals,maximumFractionDigits:decimals}).format(initial):initial;
 return `<text x="${x}" y="${y}" class="${cls}" text-anchor="${anchor}">${prefix?`<tspan>${escapeXml(prefix)} </tspan>`:''}<tspan data-value="${key}" data-decimals="${decimals}" data-kind="${typeof initial}" data-raw="${escapeXml(initial)}">${escapeXml(display)}</tspan><tspan>${unit?' '+escapeXml(unit):''}</tspan></text>`;
};
const picture = (name,x,y,width,height) => `<image href="/nhietdien/assets/equipment/${name}.webp" x="${x}" y="${y}" width="${width}" height="${height}" preserveAspectRatio="xMidYMid meet" aria-hidden="true"/>`;
const pipe = (path,color='steam',arrow=true) => `<path d="${path}" class="diagram-pipe ${color}"${arrow?` marker-end="url(#${type}-${color}-arrow)"`:''}/>`;
const statusLabel = state => state==='stopped'?'Dừng (bảo dưỡng)':state==='warning'?'Cảnh báo':'Đang vận hành';
const status = (x,y,key,width=110) => `<g data-state="${key}" class="diagram-status ${escapeXml(model[key])}"><rect x="${x}" y="${y}" width="${width}" height="21" rx="3"/><text x="${x+width/2}" y="${y+15}" text-anchor="middle">${statusLabel(model[key])}</text></g>`;
%>
<svg class="reference-schematic live-schematic <%= type %>-schematic" data-diagram="<%= type %>" viewBox="0 0 <%= w %> <%= h %>" role="img" aria-label="<%= label %>">
 <title><%= label %></title>
