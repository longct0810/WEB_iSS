<% const selectedAiView = typeof aiView !== 'undefined' ? aiView : 'overview'; %>
<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#073b70">
  <title><%= title %> | EnMS Nhiệt điện Hải Phòng</title>
  <link rel="stylesheet" href="/icons/font-awesome/css/all.min.css">
  <link rel="stylesheet" href="/nhietdien/app.css">
  <link rel="stylesheet" href="/nhietdien/fidelity.css">
</head>
<body data-page="<%= page %>">
  <div class="app-shell">
    <aside class="sidebar">
      <a class="brand" href="/nhietdien/preview/overview" aria-label="EnMS Nhiệt điện Hải Phòng"><img class="factory-logo" src="/nhietdien/assets/factory-logo.webp" alt="Nhiệt điện Hải Phòng"></a>
      <div class="nav-group-title">VẬN HÀNH &amp; HIỆU SUẤT</div>
      <nav class="main-nav" aria-label="Điều hướng chính">
        <a class="nav-link <%= page === 'overview' ? 'active' : '' %>" href="/nhietdien/preview/overview"><span><i class="fas fa-home" aria-hidden="true"></i></span>Tổng quan</a>
        <a class="nav-link <%= page === 'realtime' ? 'active' : '' %>" href="/nhietdien/preview/realtime"><span><i class="fas fa-tachometer-alt" aria-hidden="true"></i></span>Giám sát thời gian thực</a>
        <a class="nav-link disabled" href="#" aria-disabled="true"><span><i class="fas fa-project-diagram" aria-hidden="true"></i></span>Dòng năng lượng &amp; Quy trình</a>
        <a class="nav-link <%= page === 'performance' ? 'active' : '' %>" href="/nhietdien/preview/performance"><span><i class="fas fa-chart-bar" aria-hidden="true"></i></span>Hiệu suất &amp; EnPI</a>
        <a class="nav-link <%= page === 'seu' ? 'active' : '' %>" href="/nhietdien/preview/seu"><span><i class="fas fa-cog" aria-hidden="true"></i></span>Điện tự dùng &amp; SEU</a>
        <a class="nav-link disabled" href="#" aria-disabled="true"><span><i class="fas fa-sitemap" aria-hidden="true"></i></span>Sơ đồ điện một sợi</a>
        <a class="nav-link <%= page === 'boiler' ? 'active' : '' %>" href="/nhietdien/preview/boiler"><span><i class="fas fa-fire" aria-hidden="true"></i></span><%= page === 'boiler' ? 'Lò hơi, Turbine & Hệ thống hơi' : 'Boiler Performance' %></a><% if (page !== 'boiler') { %><a class="nav-link" href="/nhietdien/preview/boiler#boiler-units"><span><i class="fas fa-industry" aria-hidden="true"></i></span>Turbine &amp; Condenser</a><% } %>
        <a class="nav-link <%= page === 'fuel' ? 'active' : '' %>" href="/nhietdien/preview/fuel"><span><i class="fas fa-industry" aria-hidden="true"></i></span>Nhiên liệu &amp; Hệ thống than</a>
        <a class="nav-link <%= page === 'emissions' ? 'active' : '' %>" href="/nhietdien/preview/emissions"><span><i class="fas fa-recycle" aria-hidden="true"></i></span>Phát thải &amp; Môi trường</a>
      </nav>
      <div class="nav-group-title">PHÂN TÍCH &amp; QUẢN TRỊ</div><nav class="main-nav"><a class="nav-link <%= page === 'reports' ? 'active' : '' %>" href="/nhietdien/preview/reports"><span><i class="fas fa-file-alt" aria-hidden="true"></i></span>Báo cáo</a><a class="nav-link <%= page === 'data' ? 'active' : '' %>" href="/nhietdien/preview/data"><span><i class="fas fa-database" aria-hidden="true"></i></span>Quản lý dữ liệu</a><a class="nav-link <%= page === 'alerts' ? 'active' : '' %>" href="/nhietdien/preview/alerts"><span><i class="fas fa-exclamation-triangle" aria-hidden="true"></i></span>Cảnh báo &amp; Sự kiện</a></nav>
      <div class="nav-group-title">KẾ HOẠCH &amp; TỐI ƯU</div><nav class="main-nav"><a class="nav-link <%= page === 'targets' ? 'active' : '' %>" href="/nhietdien/preview/targets"><span><i class="fas fa-bullseye" aria-hidden="true"></i></span>Mục tiêu năng lượng</a><a class="nav-link <%= page === 'opportunities' ? 'active' : '' %>" href="/nhietdien/preview/opportunities"><span><i class="fas fa-lightbulb" aria-hidden="true"></i></span>Cơ hội tiết kiệm năng lượng</a><a class="nav-link <%= page === 'plans' ? 'active' : '' %>" href="/nhietdien/preview/plans"><span><i class="fas fa-tasks" aria-hidden="true"></i></span>Kế hoạch thực hiện</a></nav>
      <div class="nav-group-title">AI &amp; TỰ ĐỘNG HÓA</div><nav class="main-nav"><a class="nav-link <%= page === 'ai' ? 'active' : '' %>" href="/nhietdien/preview/ai"><span><i class="fas fa-brain" aria-hidden="true"></i></span>Phân tích nâng cao (AI)</a><a class="nav-link <%= page === 'optimize' ? 'active' : '' %>" href="/nhietdien/preview/optimize"><span><i class="fas fa-tachometer-alt" aria-hidden="true"></i></span>Tối ưu vận hành</a><a class="nav-link <%= page === 'admin' ? 'active' : '' %>" href="/nhietdien/preview/admin"><span><i class="fas fa-cog" aria-hidden="true"></i></span>Quản trị hệ thống</a><a class="nav-link <%= page === 'settings' ? 'active' : '' %>" href="/nhietdien/preview/settings"><span><i class="fas fa-cog" aria-hidden="true"></i></span>Cài đặt</a></nav>
      <div class="sidebar-foot"><span class="online-dot"></span>Hệ thống preview · Dữ liệu mô phỏng</div>
    </aside>

    <main class="main-area">
      <header class="top-header">
        <div class="factory-banner"><div class="header-title">HỆ THỐNG QUẢN LÝ NĂNG LƯỢNG <span>(EnMS)</span><small>CÔNG TY NHIỆT ĐIỆN HẢI PHÒNG · CÔNG SUẤT <%= ['overview','realtime','performance','seu','boiler','fuel','emissions'].includes(page) ? '1.200 MW (4 × 300 MW)' : '600 MW (2 × 300 MW)' %></small></div><div class="header-tools"><span class="header-time"><span class="clock" id="clock">15:24:36</span><small>Thứ 2, 12/10/2026</small></span><button class="icon-button" aria-label="Thông báo"><span class="fas fa-bell" aria-hidden="true"></span><i>3</i></button><a class="icon-button" href="/nhietdien/preview/settings" aria-label="Cài đặt"><span class="fas fa-cog" aria-hidden="true"></span></a><button class="icon-button" aria-label="Tài khoản"><span class="fas fa-user" aria-hidden="true"></span></button></div></div>
        <div class="context-bar"><span class="page-context"><%= ({overview:'BẢNG ĐIỀU KHIỂN TOÀN NHÀ MÁY',realtime:'M2. GIÁM SÁT THỜI GIAN THỰC',performance:'M4. HIỆU SUẤT, EnPI VÀ EnB TỔ MÁY',seu:'M5. SƠ ĐỒ ĐIỆN 1 SỢI, ĐIỆN TỰ DÙNG & SEU',boiler:'M7. LÒ HƠI, TURBINE & HỆ THỐNG HƠI',fuel:'M8. NHIÊN LIỆU, HỆ THỐNG THAN NHÀ MÁY',reports:'M11. BÁO CÁO',data:'M12. QUẢN LÝ DỮ LIỆU',alerts:'M13. CẢNH BÁO & SỰ KIỆN',plans:'M16. KẾ HOẠCH THỰC HIỆN',targets:'M14. MỤC TIÊU NĂNG LƯỢNG',opportunities:'M15. CƠ HỘI TIẾT KIỆM NĂNG LƯỢNG',optimize:'M18. TỐI ƯU VẬN HÀNH',emissions:'M9. PHÁT THẢI & MÔI TRƯỜNG',admin:'M19. QUẢN TRỊ HỆ THỐNG',settings:'M20. CÀI ĐẶT HỆ THỐNG',ai:'M17. PHÂN TÍCH NÂNG CAO (AI)'})[page] %></span>
          <% if (page === 'overview') { %><label>Đến hết ngày <select><option>31/05/2024 (n-1)</option><option>Hôm nay</option></select></label><label>Nhà máy <select><option>Toàn nhà máy</option><option>Tổ máy 1</option></select></label>
          <% } else if (page === 'realtime') { %><label>Tổ máy <select><option>Tất cả tổ máy</option><option>Tổ máy 1</option><option>Tổ máy 2</option><option>Tổ máy 3</option><option>Tổ máy 4</option></select></label><label>Chu kỳ cập nhật <select><option>5 giây</option><option>10 giây</option><option>30 giây</option></select></label><label>Thời điểm <select><option>12/10/2026 13:18:00</option><option>Thời gian thực</option></select></label>
          <% } else if (page === 'performance') { %><label>Đến hết ngày <select><option>03/10/2026 (N-1)</option><option>Hôm nay</option></select></label><label>So sánh <select><option>Cùng kỳ năm trước (2025)</option><option>Kế hoạch năm</option></select></label><button class="toolbar-action">▤ Xuất báo cáo</button>
          <% } else if (page === 'seu') { %><label>Khoảng thời gian <select><option>Hôm nay</option><option>Tháng này</option></select></label><label>Thời điểm <select><option>12/10/2026 13:18:00</option><option>Thời gian thực</option></select></label><button class="toolbar-action">⛶ Toàn màn hình</button><button class="toolbar-action">▤ Xuất báo cáo</button>
          <% } else if (page === 'boiler') { %><label>Khoảng thời gian <select><option>Hôm nay</option><option>Hôm qua</option><option>7 ngày qua</option></select></label><label>Ngày <select><option>12/10/2026</option><option>11/10/2026</option></select></label><button class="toolbar-action">⛶ Toàn màn hình</button>
          <% } else if (page === 'fuel') { %><label>Tổ máy <select><option>Tất cả</option><option>Tổ máy 1</option><option>Tổ máy 2</option><option>Tổ máy 3</option><option>Tổ máy 4</option></select></label><label>Khoảng thời gian <select><option>Hôm nay</option><option>Tháng này</option></select></label><label>Ngày <select><option>12/10/2026</option><option>11/10/2026</option></select></label>
          <% } else if (page === 'reports') { %><label>Tổ máy <select><option>Tất cả</option><option>Tổ máy 1</option><option>Tổ máy 2</option><option>Tổ máy 3</option><option>Tổ máy 4</option></select></label><label>Loại báo cáo <select><option>Tháng</option><option>Ngày</option><option>Quý</option><option>Năm</option></select></label><label>Tháng <select><option>10/2026</option><option>09/2026</option></select></label><button class="toolbar-action primary-action">▤ Tạo báo cáo</button>
          <% } else if (page === 'ai') { %><label>Tổ máy <select><option>Tất cả</option><option>Tổ máy 1</option><option>Tổ máy 2</option><option>Tổ máy 3</option><option>Tổ máy 4</option></select></label><label>Thời gian <select><option>7 ngày qua</option><option>30 ngày qua</option><option>Tháng này</option></select></label><label>Khoảng ngày <select><option>06/10/2026 – 12/10/2026</option></select></label><% } else if (page === 'plans') { %><label>Năm <select><option>2026</option></select></label><label>Phạm vi <select><option>Toàn nhà máy</option></select></label><label>Trạng thái <select><option>Tất cả</option><option>Đang thực hiện</option></select></label><button class="toolbar-action primary-action">＋ Thêm kế hoạch</button><% } else if (page === 'data') { %><label>Tổ máy <select><option>Tất cả</option><option>Tổ máy 1</option><option>Tổ máy 2</option></select></label><label>Khoảng thời gian <select><option>Hôm nay</option><option>7 ngày qua</option></select></label><label>Ngày <select><option>12/10/2026</option></select></label><% } else if (page === 'targets') { %><label>Tổ máy <select><option>Tất cả</option><option>Tổ máy 1</option><option>Tổ máy 2</option></select></label><label>Thời gian <select><option>Năm 2026</option><option>Năm 2025</option></select></label><button class="toolbar-action primary-action">＋ Thêm mục tiêu</button><% } else if (page === 'opportunities') { %><label>Tổ máy <select><option>Tất cả</option><option>Tổ máy 1</option><option>Tổ máy 2</option></select></label><label>Khu vực <select><option>Tất cả</option><option>Lò hơi</option><option>Turbine</option></select></label><label>Trạng thái <select><option>Tất cả</option><option>Khả thi cao</option></select></label><label>Năm <select><option>2026</option><option>2025</option></select></label><% } else if (page === 'optimize') { %><label>Tổ máy <select><option>Tất cả</option><option>Tổ máy 1</option><option>Tổ máy 2</option></select></label><label>Thời gian <select><option>Tháng này</option><option>Quý này</option></select></label><label>Khoảng ngày <select><option>01/10/2026 – 31/10/2026</option></select></label><% } else if (page === 'emissions') { %><label>Tổ máy <select><option>Tất cả</option><option>Tổ máy 1</option><option>Tổ máy 2</option><option>Tổ máy 3</option><option>Tổ máy 4</option></select></label><label>Khoảng thời gian <select><option>Hôm nay</option><option>7 ngày qua</option></select></label><label>Ngày <select><option>12/10/2026</option></select></label><button class="toolbar-action">▤ Xuất báo cáo</button><% } else if (page === 'admin') { %><span class="toolbar-note">HỆ THỐNG ĐANG HOẠT ĐỘNG · CẬP NHẬT 15:09</span><% } else if (page === 'settings') { %><span class="toolbar-note">CẤU HÌNH HỆ THỐNG NĂNG LƯỢNG</span><% } else { %><label>Tổ máy <select><option>Tất cả tổ máy</option></select></label><label>Mức độ <select><option>Tất cả mức độ</option></select></label><label>Thời gian <select><option>24 giờ qua</option></select></label><button class="toolbar-action primary-action">✓ Xác nhận tất cả</button><% } %>
        </div>
      </header>

      <% if (page === 'overview') { %>
      <section class="dashboard overview">
        <div class="overview-top">
          <article class="panel process-panel">
            <h2><b>1</b>SƠ ĐỒ HỆ THỐNG NĂNG LƯỢNG NHÀ MÁY</h2>
            <div class="plant-diagram hmi-diagram">
              <%- include('partials/diagram', { type: 'overview', label: 'Sơ đồ hệ thống năng lượng nhà máy' }) %>
            </div>
                     </article>
          <article class="panel units-panel">
            <h2><b>2</b>TỔNG CÔNG SUẤT PHÁT ĐIỆN VÀ SẢN LƯỢNG ĐIỆN</h2>
            <div class="unit-cards">
              <% const units=[['Tổ máy 1','286','95%','6.812','1.234.560','Đang vận hành'],['Tổ máy 2','289','96%','6.901','1.248.320','Đang vận hành'],['Tổ máy 3','0','0%','0','980.420','Dừng bảo dưỡng'],['Tổ máy 4','296','99%','7.054','1.210.350','Đang vận hành']]; units.forEach((u,i)=> { %>
              <div class="unit-card">
                <div class="unit-card-title"><b><%= u[0] %></b><small>300 MW</small></div>
                <span class="state <%= i===2?'stopped':'' %>"><%= u[5] %></span>
                <div class="unit-readings">
                  <div class="unit-reading"><span>Công suất hiện tại</span><strong><%= u[1] %> MW <small><%= u[2] %></small></strong></div>
                  <div class="unit-reading"><span>Sản lượng ngày</span><strong><%= u[3] %> MWh</strong></div>
                  <div class="unit-reading"><span>Sản lượng lũy kế</span><strong><%= u[4] %> MWh</strong></div>
                </div>
              </div><% }) %>
            </div>
            <div class="mini-stats"><span>⚙ Tổng công suất khả dụng <b>1.200 MW</b></span><span>▥ Tổng công suất phát <b>871 MW (72,6%)</b></span><span>◷ Tổng sản lượng điện ngày <b>20.767 MWh</b></span><span>▤ Lũy kế năm <b>4.673.650 MWh</b></span></div>
          </article>
        </div>
        <div class="overview-bottom">
          <article class="panel self-use"><h2><b>3</b>ĐIỆN NĂNG TỰ DÙNG TOÀN NHÀ MÁY</h2>
            <div class="self-summary"><span class="self-metric"><i>⚡</i><span>Tổng điện năng phát<strong>20.767 MWh</strong></span></span><span class="self-metric"><i class="red-icon">♨</i><span>Điện năng tự dùng<strong>560 MWh</strong></span></span><span class="self-metric"><i class="green-icon">◷</i><span>Tỷ lệ điện tự dùng<strong>2,70%</strong></span></span></div>
            <div class="self-breakdown"><div class="donut"><span>560 MWh<small>2,70%</small></span></div><div class="self-legend-title">Cơ cấu điện tự dùng theo phụ tải (MWh, %)</div><ul class="legend"><li><i class="c1"></i>Bơm nước làm mát (CWP)<b>178&nbsp; (31,8%)</b></li><li><i class="c2"></i>Quạt gió (IDF/FD/PA)<b>112&nbsp; (20,0%)</b></li><li><i class="c3"></i>Nghiền than<b>84&nbsp; (15,0%)</b></li><li><i class="c4"></i>Hệ thống FGD / ESP<b>67&nbsp; (12,0%)</b></li><li><i class="c5"></i>Bơm nước cấp (BFP)<b>56&nbsp; (10,0%)</b></li><li><i class="c6"></i>Phụ trợ, HVAC, chiếu sáng<b>63&nbsp; (11,2%)</b></li></ul></div>
          </article>
          <article class="panel coal-stock"><h2><b>4</b>SUẤT TIÊU HAO THAN VÀ TỒN KHO</h2>
            <div class="coal-metrics"><div class="coal-metric"><span class="coal-pile">▰</span><div><small>Suất tiêu hao than</small><strong>304 <small>g/kWh</small></strong><em>▼ −6,2 g/kWh</em><small>so với kế hoạch (310)</small></div><div class="coal-truck">🚚<small>Tổng lượng than tiêu thụ ngày</small><strong>6.316 tấn</strong></div></div>
            <div class="coal-metric"><span class="coal-pile">▰</span><div><small>Tồn kho than hiện tại</small><strong>886.000 tấn</strong></div><div class="stock-clock">◷<small>Thời gian dự kiến</small><strong>37,9 ngày</strong><small>với mức tiêu thụ TB 23.400 tấn/ngày</small></div></div></div>
          </article>
          <article class="panel heat-rate"><h2><b>5</b>SUẤT TIÊU HAO NHIỆT</h2><div class="heat-body"><div class="flame">♨</div><div><small>Suất tiêu hao nhiệt (HHV)</small><strong>8.680 <small>kJ/kWh</small></strong><em>▼ −170 kJ/kWh<br>so với kế hoạch (8.850)</em></div></div></article>
        </div>
        <article class="panel plan-panel"><h2><b>6</b>SO SÁNH VỚI KẾ HOẠCH / MỤC TIÊU <span class="metric-tabs"><button class="selected">Sản lượng điện</button><button>Suất tiêu hao than</button><button>Suất tiêu hao nhiệt</button><button>Tỷ lệ điện tự dùng</button></span></h2>
          <div class="plan-grid"><div><div class="chart-title">Sản lượng điện (MWh) <span class="chart-legend"><i></i>Thực hiện　● Kế hoạch　— Mục tiêu</span></div><div class="bar-chart"><% [45,39,53,60,62,69,75,78,82,78,86,90].forEach((h,i)=> { %><span style="height:<%= h %>%"><i><%= i+1 %></i></span><% }) %></div></div><div><div class="chart-title">Sản lượng điện (lũy kế)</div><table class="compact-table"><tr><th></th><th>Thực hiện</th><th>Kế hoạch</th><th>So sánh</th><th>Đạt (%)</th></tr><tr><td>Năm</td><td>4.673.650</td><td>5.112.000</td><td class="warn">−438.350</td><td class="warn">91,4%</td></tr><tr><td>Quý 1</td><td>1.210.320</td><td>1.280.000</td><td>−69.680</td><td>94,6%</td></tr><tr><td>Quý 2</td><td>1.560.480</td><td>1.706.000</td><td>−145.520</td><td>91,4%</td></tr><tr><td>Tháng 5</td><td>812.350</td><td>853.000</td><td>−40.650</td><td>95,2%</td></tr></table></div><div><div class="chart-title">Tỷ lệ đạt kế hoạch theo tháng (%)</div><div class="trend-chart"><svg viewBox="0 0 420 140" preserveAspectRatio="none"><path d="M0 92 L35 75 70 83 105 54 140 64 175 50 210 68 245 44 280 57 315 35 350 49 385 27 420 39" fill="none" stroke="#1683d8" stroke-width="3"/><path d="M0 48 L35 67 70 53 105 74 140 49 175 61 210 45 245 62 280 37 315 52 350 31 385 55 420 43" fill="none" stroke="#28aa74" stroke-width="3"/><path d="M0 62 L35 58 70 67 105 61 140 70 175 65 210 73 245 69 280 74 315 67 350 77 385 71 420 75" fill="none" stroke="#f0a222" stroke-width="2"/></svg></div></div></div>
        </article>
      </section>
      <% } else if (page === 'realtime') { %>
      <section class="dashboard realtime">
        <div class="tabs"><a class="selected" href="/nhietdien/preview/realtime">Tổng quan</a><a href="#unit-table">Tổ máy 1</a><a href="#unit-table">Tổ máy 2</a><a href="#unit-table">Tổ máy 3</a><a href="#unit-table">Tổ máy 4</a><a href="#aux">Hệ thống phụ trợ</a><a href="#fuel">Nhiên liệu</a><a href="#aux">Nước &amp; Ngưng</a><a href="#environment">Điện tải</a><a href="#alerts">Cảnh báo</a></div>
        <div class="kpi-grid">
