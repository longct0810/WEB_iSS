  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#073b70">
  <title><%= title %> | EnMS Nhiệt điện Hải Phòng</title>
  <link rel="stylesheet" href="/nhietdien/app.css">
</head>
<body>
  <div class="app-shell">
    <aside class="sidebar">
      <a class="brand" href="/nhietdien/preview/overview" aria-label="EnMS Nhiệt điện Hải Phòng"><span class="brand-mark">⚡</span><span class="brand-name">HẢI PHÒNG<br><small>THERMAL POWER</small></span></a>
      <div class="nav-group-title">VẬN HÀNH &amp; HIỆU SUẤT</div>
      <nav class="main-nav" aria-label="Điều hướng chính">
        <a class="nav-link <%= page === 'overview' ? 'active' : '' %>" href="/nhietdien/preview/overview"><span>⌂</span>Tổng quan</a>
        <a class="nav-link <%= page === 'realtime' ? 'active' : '' %>" href="/nhietdien/preview/realtime"><span>◉</span>Giám sát thời gian thực</a>
        <a class="nav-link disabled" href="#" aria-disabled="true"><span>⇄</span>Dòng năng lượng &amp; Quy trình</a>
        <a class="nav-link <%= page === 'performance' ? 'active' : '' %>" href="/nhietdien/preview/performance"><span>▥</span>Hiệu suất &amp; EnPI</a>
        <a class="nav-link <%= page === 'seu' ? 'active' : '' %>" href="/nhietdien/preview/seu"><span>⚙</span>Điện tự dùng &amp; SEU</a>
        <a class="nav-link disabled" href="#" aria-disabled="true"><span>⌘</span>Sơ đồ điện một sợi</a>
        <a class="nav-link <%= page === 'boiler' ? 'active' : '' %>" href="/nhietdien/preview/boiler"><span>♨</span>Lò hơi, Turbine &amp; Hệ thống hơi</a>
        <a class="nav-link <%= page === 'fuel' ? 'active' : '' %>" href="/nhietdien/preview/fuel"><span>◆</span>Nhiên liệu &amp; Hệ thống than</a>
      </nav>
      <div class="nav-group-title">PHÂN TÍCH &amp; QUẢN TRỊ</div><nav class="main-nav"><a class="nav-link <%= page === 'reports' ? 'active' : '' %>" href="/nhietdien/preview/reports"><span>▤</span>Báo cáo</a><a class="nav-link <%= page === 'data' ? 'active' : '' %>" href="/nhietdien/preview/data"><span>▧</span>Quản lý dữ liệu</a><a class="nav-link <%= page === 'alerts' ? 'active' : '' %>" href="/nhietdien/preview/alerts"><span>⚠</span>Cảnh báo &amp; Sự kiện</a></nav>
      <div class="nav-group-title">KẾ HOẠCH &amp; TỐI ƯU</div><nav class="main-nav"><a class="nav-link <%= page === 'targets' ? 'active' : '' %>" href="/nhietdien/preview/targets"><span>◎</span>Mục tiêu năng lượng</a><a class="nav-link <%= page === 'opportunities' ? 'active' : '' %>" href="/nhietdien/preview/opportunities"><span>✦</span>Cơ hội tiết kiệm năng lượng</a><a class="nav-link <%= page === 'plans' ? 'active' : '' %>" href="/nhietdien/preview/plans"><span>☷</span>Kế hoạch thực hiện</a></nav>
      <div class="nav-group-title">AI &amp; TỰ ĐỘNG HÓA</div><nav class="main-nav"><a class="nav-link <%= page === 'ai' ? 'active' : '' %>" href="/nhietdien/preview/ai"><span>✣</span>Phân tích nâng cao (AI)</a><a class="nav-link <%= page === 'optimize' ? 'active' : '' %>" href="/nhietdien/preview/optimize"><span>◉</span>Tối ưu vận hành</a><a class="nav-link disabled" href="#" aria-disabled="true"><span>⚙</span>Quản trị hệ thống</a></nav>
      <div class="sidebar-foot"><span class="online-dot"></span>Hệ thống preview · Dữ liệu mô phỏng</div>
    </aside>

    <main class="main-area">
      <header class="top-header">
        <div class="factory-banner"><div class="header-title">HỆ THỐNG QUẢN LÝ NĂNG LƯỢNG <span>(EnMS)</span><small>CÔNG TY NHIỆT ĐIỆN HẢI PHÒNG · CÔNG SUẤT 1.200 MW (4 × 300 MW)</small></div><div class="header-tools"><span class="preview-badge">PREVIEW</span><span class="clock" id="clock">15:24:36</span><button class="icon-button" aria-label="Thông báo">♧<i>3</i></button><button class="icon-button" aria-label="Tài khoản">●</button></div></div>
        <div class="context-bar"><span class="page-context"><%= ({overview:'BẢNG ĐIỀU KHIỂN TOÀN NHÀ MÁY',realtime:'M2. GIÁM SÁT THỜI GIAN THỰC',performance:'M4. HIỆU SUẤT, EnPI VÀ EnB TỔ MÁY',seu:'M5. SƠ ĐỒ ĐIỆN 1 SỢI, ĐIỆN TỰ DÙNG & SEU',boiler:'M7. LÒ HƠI, TURBINE & HỆ THỐNG HƠI',fuel:'M8. NHIÊN LIỆU, HỆ THỐNG THAN NHÀ MÁY',reports:'M11. BÁO CÁO',data:'M12. QUẢN LÝ DỮ LIỆU',alerts:'M13. CẢNH BÁO & SỰ KIỆN',plans:'M16. KẾ HOẠCH THỰC HIỆN',targets:'M14. MỤC TIÊU NĂNG LƯỢNG',opportunities:'M15. CƠ HỘI TIẾT KIỆM NĂNG LƯỢNG',optimize:'M18. TỐI ƯU VẬN HÀNH',ai:'M17. PHÂN TÍCH NÂNG CAO (AI)'})[page] %></span>
          <% if (page === 'overview') { %><label>Đến hết ngày <select><option>31/05/2024 (n-1)</option><option>Hôm nay</option></select></label><label>Nhà máy <select><option>Toàn nhà máy</option><option>Tổ máy 1</option></select></label>
          <% } else if (page === 'realtime') { %><label>Tổ máy <select><option>Tất cả tổ máy</option><option>Tổ máy 1</option><option>Tổ máy 2</option><option>Tổ máy 3</option><option>Tổ máy 4</option></select></label><label>Chu kỳ cập nhật <select><option>5 giây</option><option>10 giây</option><option>30 giây</option></select></label><label>Thời điểm <select><option>12/10/2026 13:18:00</option><option>Thời gian thực</option></select></label>
          <% } else if (page === 'performance') { %><label>Đến hết ngày <select><option>03/10/2026 (N-1)</option><option>Hôm nay</option></select></label><label>So sánh <select><option>Cùng kỳ năm trước (2025)</option><option>Kế hoạch năm</option></select></label><button class="toolbar-action">▤ Xuất báo cáo</button>
          <% } else if (page === 'seu') { %><label>Khoảng thời gian <select><option>Hôm nay</option><option>Tháng này</option></select></label><label>Thời điểm <select><option>12/10/2026 13:18:00</option><option>Thời gian thực</option></select></label><button class="toolbar-action">⛶ Toàn màn hình</button><button class="toolbar-action">▤ Xuất báo cáo</button>
          <% } else if (page === 'boiler') { %><label>Khoảng thời gian <select><option>Hôm nay</option><option>Hôm qua</option><option>7 ngày qua</option></select></label><label>Ngày <select><option>12/10/2026</option><option>11/10/2026</option></select></label><button class="toolbar-action">⛶ Toàn màn hình</button>
          <% } else if (page === 'fuel') { %><label>Tổ máy <select><option>Tất cả</option><option>Tổ máy 1</option><option>Tổ máy 2</option><option>Tổ máy 3</option><option>Tổ máy 4</option></select></label><label>Khoảng thời gian <select><option>Hôm nay</option><option>Tháng này</option></select></label><label>Ngày <select><option>12/10/2026</option><option>11/10/2026</option></select></label>
          <% } else if (page === 'reports') { %><label>Tổ máy <select><option>Tất cả</option><option>Tổ máy 1</option><option>Tổ máy 2</option><option>Tổ máy 3</option><option>Tổ máy 4</option></select></label><label>Loại báo cáo <select><option>Tháng</option><option>Ngày</option><option>Quý</option><option>Năm</option></select></label><label>Tháng <select><option>10/2026</option><option>09/2026</option></select></label><button class="toolbar-action primary-action">▤ Tạo báo cáo</button>
          <% } else if (page === 'ai') { %><label>Tổ máy <select><option>Tất cả</option><option>Tổ máy 1</option><option>Tổ máy 2</option><option>Tổ máy 3</option><option>Tổ máy 4</option></select></label><label>Thời gian <select><option>7 ngày qua</option><option>30 ngày qua</option><option>Tháng này</option></select></label><label>Khoảng ngày <select><option>06/10/2026 – 12/10/2026</option></select></label><% } else if (page === 'plans') { %><label>Năm <select><option>2026</option></select></label><label>Phạm vi <select><option>Toàn nhà máy</option></select></label><label>Trạng thái <select><option>Tất cả</option><option>Đang thực hiện</option></select></label><button class="toolbar-action primary-action">＋ Thêm kế hoạch</button><% } else if (page === 'data') { %><label>Tổ máy <select><option>Tất cả</option><option>Tổ máy 1</option><option>Tổ máy 2</option></select></label><label>Khoảng thời gian <select><option>Hôm nay</option><option>7 ngày qua</option></select></label><label>Ngày <select><option>12/10/2026</option></select></label><% } else if (page === 'targets') { %><label>Tổ máy <select><option>Tất cả</option><option>Tổ máy 1</option><option>Tổ máy 2</option></select></label><label>Thời gian <select><option>Năm 2026</option><option>Năm 2025</option></select></label><button class="toolbar-action primary-action">＋ Thêm mục tiêu</button><% } else if (page === 'opportunities') { %><label>Tổ máy <select><option>Tất cả</option><option>Tổ máy 1</option><option>Tổ máy 2</option></select></label><label>Khu vực <select><option>Tất cả</option><option>Lò hơi</option><option>Turbine</option></select></label><label>Trạng thái <select><option>Tất cả</option><option>Khả thi cao</option></select></label><label>Năm <select><option>2026</option><option>2025</option></select></label><% } else if (page === 'optimize') { %><label>Tổ máy <select><option>Tất cả</option><option>Tổ máy 1</option><option>Tổ máy 2</option></select></label><label>Thời gian <select><option>Tháng này</option><option>Quý này</option></select></label><label>Khoảng ngày <select><option>01/10/2026 – 31/10/2026</option></select></label><% } else { %><label>Tổ máy <select><option>Tất cả tổ máy</option></select></label><label>Mức độ <select><option>Tất cả mức độ</option></select></label><label>Thời gian <select><option>24 giờ qua</option></select></label><button class="toolbar-action primary-action">✓ Xác nhận tất cả</button><% } %>
        </div>
      </header>

      <% if (page === 'overview') { %>
      <section class="dashboard overview">
        <div class="overview-top">
          <article class="panel process-panel">
            <h2><b>1</b>SƠ ĐỒ HỆ THỐNG NĂNG LƯỢNG NHÀ MÁY</h2>
            <div class="plant-diagram hmi-diagram">
              <svg class="plant-flow hmi-flow" viewBox="0 0 1080 440" role="img" aria-label="Sơ đồ HMI quy trình năng lượng nhà máy nhiệt điện">
                <defs>
                  <pattern id="hmi-grid" width="20" height="20" patternUnits="userSpaceOnUse"><path d="M20 0H0V20" fill="none" stroke="#dce8f0" stroke-width=".7"/></pattern>
                  <linearGradient id="hmi-metal" x2="0" y2="1"><stop stop-color="#f8fcff"/><stop offset=".48" stop-color="#dce8f0"/><stop offset="1" stop-color="#b8cad6"/></linearGradient>
                  <linearGradient id="hmi-fire" x2="0" y2="1"><stop stop-color="#fff6a9"/><stop offset=".5" stop-color="#ff9c36"/><stop offset="1" stop-color="#db382d"/></linearGradient>
                  <linearGradient id="hmi-water" x2="0" y2="1"><stop stop-color="#caefff"/><stop offset="1" stop-color="#66bce8"/></linearGradient>
                  <filter id="hmi-glow" x="-40%" y="-40%" width="180%" height="180%"><feGaussianBlur stdDeviation="2.5" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
                  <marker id="hmi-arrow-fuel" markerWidth="9" markerHeight="9" refX="7" refY="4" orient="auto"><path d="M0 0L8 4 0 8z" fill="#dc8b25"/></marker>
                  <marker id="hmi-arrow-steam" markerWidth="9" markerHeight="9" refX="7" refY="4" orient="auto"><path d="M0 0L8 4 0 8z" fill="#df4945"/></marker>
                  <marker id="hmi-arrow-water" markerWidth="9" markerHeight="9" refX="7" refY="4" orient="auto"><path d="M0 0L8 4 0 8z" fill="#1684c7"/></marker>
                  <marker id="hmi-arrow-power" markerWidth="9" markerHeight="9" refX="7" refY="4" orient="auto"><path d="M0 0L8 4 0 8z" fill="#25894d"/></marker>
                  <marker id="hmi-arrow-ash" markerWidth="9" markerHeight="9" refX="7" refY="4" orient="auto"><path d="M0 0L8 4 0 8z" fill="#6d7580"/></marker>
                </defs>
                <rect x="1" y="1" width="1078" height="438" rx="8" fill="#fbfdff" stroke="#d4e1eb"/>
                <rect x="1" y="1" width="1078" height="438" rx="8" fill="url(#hmi-grid)" opacity=".55"/>
                <g class="hmi-topline">
                  <text x="18" y="23">SƠ ĐỒ QUY TRÌNH NHIỆT ĐIỆN · HỆ THỐNG ĐANG VẬN HÀNH</text>
                  <rect x="825" y="9" width="235" height="23" rx="11" fill="#e8f7ed" stroke="#b4dfc2"/>
                  <circle cx="840" cy="20" r="4" fill="#25a65d" class="hmi-blink"/>
                  <text x="851" y="24">TỔNG PHÁT 871 MW</text>
                  <g transform="translate(18 42)" class="hmi-legend">
                    <path d="M0 0h28" class="fuel-line"/><text x="34" y="4">Nhiên liệu</text>
                    <path d="M118 0h28" class="steam-line"/><text x="152" y="4">Hơi</text>
                    <path d="M205 0h28" class="water-line"/><text x="239" y="4">Nước</text>
                    <path d="M296 0h28" class="power-line"/><text x="330" y="4">Điện</text>
                    <path d="M384 0h28" class="ash-line"/><text x="418" y="4">Tro xỉ</text>
                  </g>
                </g>

                <!-- Coal storage and fuel preparation -->
                <g class="hmi-equipment">
                  <rect x="18" y="93" width="122" height="122" rx="7" class="hmi-frame"/>
                  <text x="29" y="110" class="hmi-caption">KHO THAN</text>
                  <path d="M34 174l26-37 24 36 19-27 24 28z" fill="#303943" stroke="#66737d" stroke-width="2"/>
                  <path d="M33 178h94v8H33z" fill="#98a8b4"/>
                  <rect x="36" y="190" width="84" height="15" rx="3" class="hmi-tag"/>
                  <text x="44" y="201" class="hmi-tagtext">886.000 tấn</text>
                  <rect x="155" y="112" width="111" height="103" rx="7" class="hmi-frame"/>
                  <text x="164" y="129" class="hmi-caption">NGHIỀN THAN</text>
                  <g class="hmi-mill"><rect x="166" y="143" width="23" height="47" rx="4"/><path d="M170 151h15m-15 8h15m-15 8h15m-15 8h15"/><circle cx="177.5" cy="196" r="4"/></g>
                  <g class="hmi-mill"><rect x="197" y="143" width="23" height="47" rx="4"/><path d="M201 151h15m-15 8h15m-15 8h15m-15 8h15"/><circle cx="208.5" cy="196" r="4"/></g>
                  <g class="hmi-mill"><rect x="228" y="143" width="23" height="47" rx="4"/><path d="M232 151h15m-15 8h15m-15 8h15m-15 8h15"/><circle cx="239.5" cy="196" r="4"/></g>
                  <circle cx="173" cy="204" r="3" class="hmi-on"/><circle cx="204" cy="204" r="3" class="hmi-on"/><circle cx="235" cy="204" r="3" class="hmi-on"/>
                  <rect x="162" y="218" width="96" height="17" rx="8" class="hmi-tag-green"/><text x="174" y="230" class="hmi-tagtext-green">3/3 MÁY RUN</text>
                  <rect x="282" y="128" width="67" height="86" rx="7" class="hmi-frame"/>
                  <text x="291" y="145" class="hmi-caption">CẤP BỘT</text>
                  <path d="M295 159h41l-7 25h-27z" fill="#e9d7b7" stroke="#9c8053" stroke-width="2"/>
                  <path d="M300 184h30v20h-30z" fill="url(#hmi-metal)" stroke="#7d96a8"/>
                  <text x="292" y="228" class="hmi-small">886 t/h</text>

                  <!-- Boiler -->
                  <rect x="372" y="88" width="126" height="173" rx="8" class="hmi-frame hmi-heavy"/>
                  <rect x="384" y="105" width="102" height="136" rx="5" fill="#eff5f8" stroke="#91a7b6" stroke-width="2"/>
                  <rect x="394" y="117" width="82" height="111" rx="3" fill="url(#hmi-fire)" stroke="#c8763f"/>
                  <path d="M405 218q9-36 18-14 12-57 22-9 9-34 19 18" fill="none" stroke="#fff5b0" stroke-width="5" filter="url(#hmi-glow)"/>
                  <path d="M401 129h67M401 139h67M401 149h67" stroke="#c2d0d8" stroke-width="2"/>
                  <path d="M424 89V69h21V89" fill="url(#hmi-metal)" stroke="#7d95a5" stroke-width="2"/>
                  <circle cx="435" cy="78" r="4" class="hmi-on"/>
                  <text x="394" y="252" class="hmi-caption">LÒ HƠI · BLR-01</text>
                  <rect x="382" y="266" width="107" height="27" rx="4" class="hmi-tag-red"/>
                  <text x="392" y="278" class="hmi-tagtext-red">17,3 MPa</text><text x="392" y="288" class="hmi-tiny">Hơi quá nhiệt · 541°C</text>
                </g>

                <!-- Turbine and generator train -->
                <g class="hmi-equipment">
                  <rect x="565" y="111" width="116" height="105" rx="7" class="hmi-frame"/>
                  <text x="577" y="128" class="hmi-caption">TUABIN HƠI</text>
                  <path d="M578 151h87l-13 16 13 16h-87l13-16z" fill="#c9dce9" stroke="#7794a8" stroke-width="2"/>
                  <path d="M595 151l11 32m5-32 10 32m6-32 9 32m5-32 9 32" stroke="#7d9bae" stroke-width="2"/>
                  <line x1="577" y1="198" x2="668" y2="198" stroke="#58778d" stroke-width="4"/>
                  <text x="582" y="211" class="hmi-tiny">4 × 300 MW</text>
                  <rect x="695" y="119" width="103" height="89" rx="9" class="hmi-frame"/>
                  <text x="710" y="136" class="hmi-caption">MÁY PHÁT</text>
                  <circle cx="746" cy="166" r="23" fill="#e8f1f6" stroke="#69869a" stroke-width="3"/>
                  <circle cx="746" cy="166" r="13" fill="#d2e5ef" stroke="#8ca5b5"/>
                  <path d="M746 143v46m-23-23h46m-39-16 32 32m0-32-32 32" stroke="#66879c" stroke-width="2"/>
                  <text x="712" y="199" class="hmi-tiny">GEN-01 · 871 MW</text>
                  <rect x="816" y="119" width="82" height="89" rx="7" class="hmi-frame"/>
                  <text x="826" y="136" class="hmi-caption">MBA TĂNG ÁP</text>
                  <path d="M835 151c15-16 15 16 30 0s15 16 24 0M835 169c15-16 15 16 30 0s15 16 24 0M835 187c15-16 15 16 30 0s15 16 24 0" fill="none" stroke="#b28742" stroke-width="3"/>
                  <text x="835" y="201" class="hmi-tiny">400 kV</text>
                  <rect x="917" y="111" width="142" height="116" rx="7" class="hmi-frame"/>
                  <text x="931" y="128" class="hmi-caption">TRẠM / LƯỚI ĐIỆN</text>
                  <path d="M957 145l22 68m-22-68-22 68m8-47h28m-32 14h40m-37 14h34m-37 14h42m-37-42 31 28m-27-41-34 41" fill="none" stroke="#617d8f" stroke-width="2"/>
                  <path d="M1002 146v65m-11-49h23m-27 12h31m-23 12h15" fill="none" stroke="#617d8f" stroke-width="2"/>
                  <text x="934" y="221" class="hmi-value-green">871 MW · ĐANG PHÁT</text>
                </g>

                <!-- Boiler steam main and unit branches -->
                <g class="hmi-pipes">
                  <path d="M498 116H556" class="steam-line flow-animated" marker-end="url(#hmi-arrow-steam)"/>
                  <path d="M498 176H556" class="steam-line flow-animated" marker-end="url(#hmi-arrow-steam)"/>
                  <path d="M681 165H693" class="shaft-line"/>
                  <path d="M798 164H813" class="power-line flow-animated" marker-end="url(#hmi-arrow-power)"/>
                  <path d="M898 164H912" class="power-line flow-animated" marker-end="url(#hmi-arrow-power)"/>
                  <path d="M140 167H151" class="fuel-line flow-animated" marker-end="url(#hmi-arrow-fuel)"/>
                  <path d="M266 166H278" class="fuel-line flow-animated" marker-end="url(#hmi-arrow-fuel)"/>
                  <path d="M349 166H367" class="fuel-line flow-animated" marker-end="url(#hmi-arrow-fuel)"/>
                  <path d="M460 242V302H530" class="steam-line"/>
                  <path d="M620 216V281H521V302" class="water-line flow-animated" marker-end="url(#hmi-arrow-water)"/>
                </g>

                <!-- Water, cooling, and ash systems -->
                <g class="hmi-equipment">
                  <rect x="380" y="309" width="165" height="57" rx="7" class="hmi-frame"/>
                  <text x="391" y="326" class="hmi-caption">BÌNH NGƯNG · CND-01</text>
                  <rect x="393" y="334" width="139" height="20" rx="3" fill="url(#hmi-water)" stroke="#83bad4"/>
                  <path d="M402 344h119m-104-6v12m20-12v12m20-12v12m20-12v12m20-12v12" stroke="#fff" stroke-width="2"/>
                  <rect x="254" y="313" width="94" height="53" rx="7" class="hmi-frame"/>
                  <text x="265" y="329" class="hmi-caption">BƠM NƯỚC CẤP</text>
                  <circle cx="285" cy="348" r="12" fill="#e3f4fb" stroke="#5597bb" stroke-width="2"/>
