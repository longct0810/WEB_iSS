<button id="issAiToggle" class="iss-ai-toggle" type="button" aria-label="Mở trợ lý AI">AI</button>
<section id="issAiPanel" class="iss-ai-panel" aria-hidden="true">
  <header class="iss-ai-header">
    <div>
      <div class="iss-ai-title">Trợ lý AI iSS</div>
      <div class="iss-ai-subtitle">Trợ lý phân tích vận hành</div>
    </div>
    <button id="issAiClose" class="iss-ai-close" type="button" aria-label="Đóng">×</button>
  </header>
  <div id="issAiMessages" class="iss-ai-messages">
    <div class="iss-ai-message assistant">
      <div class="iss-ai-bubble">Xin chào. Tôi có thể giải thích cảnh báo và hỗ trợ tra cứu vận hành iSS.</div>
    </div>
  </div>
  <footer class="iss-ai-footer">
    <textarea id="issAiInput" class="iss-ai-input" rows="1" maxlength="2000" placeholder="Nhập câu hỏi..."></textarea>
    <button id="issAiSend" class="iss-ai-send" type="button">Gửi</button>
  </footer>
</section>
