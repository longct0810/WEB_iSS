            <style type="text/css">
                html,
                body {
                    height: 100%;
                    overflow: hidden !important;
                }

                #SVGWrapper {
                    height: calc(100vh - 70px);
                    overflow: hidden;
                    padding: 0 10px 10px;
                }

                #SVGViewport {
                    width: 100%;
                    height: 100%;
                    position: relative;
                    overflow: hidden !important;
                    border-radius: 8px;
                    background: #f8f9fa;
                }

                #SVGViewport.bg-dark-svg {
                    background: #1e1e1e;
                }

                #SVGViewport.bg-blue-svg {
                    background: #eaf4ff;
                }

                #SVGViewport.bg-black-svg {
                    background: #000;
                }

                #SVGViewport.bg-dark-svg svg #khung rect {
                    stroke: #fff !important;
                }


                #SVGViewport.bg-dark-svg svg #khung #bangten rect {
                    fill: #0283fc !important;
                    stroke: #fff !important;
                }

                #SVGViewport.bg-dark-svg svg #gtext path {
                    stroke: #fff !important;
                }


                #SVGViewport.bg-dark-svg svg #daydien path {
                    stroke: #06ebdf !important;
                    /* stroke-width: 1 !important;
                    stroke-dasharray: 5, 10 !important;
                    animation: electricFlow .5s linear infinite;
                    filter: drop-shadow(0 0 1px #d30be6) drop-shadow(0 0 1px #d80bac); */
                }

                #SVGViewport.bg-dark-svg svg #daydien rect {
                    fill: #06ebdf !important;
                    stroke: #06ebdf !important;
                }

                @keyframes electricFlow {
                    from {
                        stroke-dashoffset: 0;
                    }

                    to {
                        stroke-dashoffset: -40;
                    }
                }

                #SVGContainer {
                    width: 100%;
                    height: 100%;
                }

                #SVGContainer svg {
                    width: 100%;
                    height: 100%;
                    display: block;
                    cursor: grab;
                }

                #SVGContainer svg:active {
                    cursor: grabbing;
                }

                /* ===== Floating toolbar góc trái SVG ===== */
                .svg-float-toolbar {
                    position: absolute;
                    top: 12px;
                    left: 12px;
                    z-index: 20;

                    display: flex;
                    align-items: center;
                    gap: 6px;

                    padding: 6px;
                    border-radius: 12px;

                    background: rgba(255, 255, 255, 0.92);
                    backdrop-filter: blur(8px);
                    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.18);
                }

                .svg-float-toolbar button {
                    width: 34px;
                    height: 34px;

                    border: 0;
                    border-radius: 9px;

                    background: #f3f4f6;
                    color: #111827;

                    display: inline-flex;
                    align-items: center;
                    justify-content: center;

                    cursor: pointer;
                    transition: all 0.18s ease;
                }

                .svg-float-toolbar button:hover {
                    background: #14b8a6;
                    color: #fff;
                }

                .svg-float-toolbar button:active {
                    transform: scale(0.95);
                }

                .svg-float-toolbar i {
                    pointer-events: none;
                }

                .svg-float-toolbar .toolbar-toggle {
                    background: #14b8a6;
                    color: #fff;
                }

                .svg-float-toolbar .toolbar-actions {
                    display: flex;
                    gap: 6px;

                    max-width: 260px;
                    opacity: 1;
                    overflow: hidden;

                    transition: max-width 0.22s ease, opacity 0.18s ease;
                }

                .svg-float-toolbar.collapsed .toolbar-actions {
                    max-width: 0;
                    opacity: 0;
                    pointer-events: none;
                }

                #SVGViewport.bg-dark-svg .svg-float-toolbar,
                #SVGViewport.bg-black-svg .svg-float-toolbar {
                    background: rgba(25, 25, 25, 0.9);
                }

                #SVGViewport.bg-dark-svg .svg-float-toolbar button,
                #SVGViewport.bg-black-svg .svg-float-toolbar button {
                    background: #333;
                    color: #eee;
                }

                #SVGViewport.bg-dark-svg .svg-float-toolbar .toolbar-toggle,
                #SVGViewport.bg-black-svg .svg-float-toolbar .toolbar-toggle {
                    background: #14b8a6;
                    color: #fff;
                }

                #SVGViewport:fullscreen {
                    width: 100vw;
                    height: 100vh;
                }

                #SVGViewport:-webkit-full-screen {
                    width: 100vw;
                    height: 100vh;
                }

                /* nền trong fullscreen */
                #SVGViewport.bg-dark-svg:fullscreen,
                #SVGViewport.bg-dark-svg:-webkit-full-screen {
                    background: #1e1e1e !important;
                }

                #SVGViewport.bg-blue-svg:fullscreen,
                #SVGViewport.bg-blue-svg:-webkit-full-screen {
                    background: #eaf4ff !important;
                }

                #SVGViewport.bg-black-svg:fullscreen,
                #SVGViewport.bg-black-svg:-webkit-full-screen {
                    background: #000 !important;
                }

                #SVGViewport:not(.bg-dark-svg):not(.bg-blue-svg):not(.bg-black-svg):fullscreen,
                #SVGViewport:not(.bg-dark-svg):not(.bg-blue-svg):not(.bg-black-svg):-webkit-full-screen {
                    background: #f8f9fa !important;
                }

                #line-layer>path {
                    stroke: #fff;
                }

                .bg-green {
                    fill: #00c853 !important;
                }

                .bg-red {
                    fill: #ff3d00 !important;
                }

                .bg-yellow {
                    fill: #ffab00 !important;
                }

                @keyframes blink {

                    0%,
                    100% {
                        opacity: 1;
                    }

                    50% {
                        opacity: 0.2;
                    }
                }

                .blink {
                    animation: blink 1s linear infinite;
                }

                .blink-glow {
                    animation: blink-glow 3s linear infinite;
                    filter: drop-shadow(0 0 1px currentColor);
                }

                @keyframes blink-glow {

                    0%,
                    100% {
                        opacity: 1;
                    }

                    50% {
                        opacity: 0.3;
                    }
                }

                /* CPANEL */
                .svg-theme-panel {
                    position: absolute;
                    top: 58px;
                    left: 12px;
                    z-index: 35;

                    width: 245px;
                    padding: 12px;

                    background: rgba(255, 255, 255, 0.96);
                    border: 1px solid #e5e7eb;
                    border-radius: 12px;

                    box-shadow: 0 8px 22px rgba(15, 23, 42, 0.18);
                }

                .svg-theme-panel.hidden {
                    display: none;
                }

                .theme-panel-title {
                    font-weight: 700;
                    font-size: 14px;
                    color: #1f2937;
                    margin-bottom: 10px;
                }

                .theme-row {
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    gap: 8px;
                    margin-bottom: 8px;
                }

                .theme-row label {
                    font-size: 13px;
                    color: #374151;
                }

                .theme-row input[type="color"] {
                    width: 42px;
                    height: 30px;
                    padding: 0;
                    border: 1px solid #d1d5db;
                    border-radius: 6px;
                    cursor: pointer;
                }

                #btnResetSvgTheme {
                    width: 100%;
                    margin-top: 8px;
                    height: 34px;
                    border: 0;
                    border-radius: 8px;
                    background: #2563eb;
                    color: #fff;
                    font-weight: 600;
                    cursor: pointer;
                }

                #btnResetSvgTheme:hover {
                    background: #1d4ed8;
                }

                #btnSvgTheme.active {
                    background: #2563eb;
                    color: #fff;
                }
            </style>