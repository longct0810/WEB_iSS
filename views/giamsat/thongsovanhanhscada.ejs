                            </button>
                        </div>

                    </div>
                </div>

                <div id="popup-content">
                    <table class="table table-bordered" id="tbl_chitiet_cambien_scada">
                        <thead>
                            <tr>
                                <th>STT</th>
                                <th>Thời gian</th>
                                <th>Nhiệt độ</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>

                </div>
            </div>
        </div>
    </div>
