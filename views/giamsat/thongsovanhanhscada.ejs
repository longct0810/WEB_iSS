                            <button class="btn btn-primary" type="button" id="btnthuchien_chitiet_cambien_scada"><i
                                    class="flaticon-013-checkmark"></i>
                                Thực hiện</button>
                        </div>
                        <div class="input-group " style="float: left;width: 200px;">
                            <button class="btn btn-success" type="button" id="btnExportExcelChiTietCambien"
                                style="margin-left: 10px;">
